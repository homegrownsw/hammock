#!/usr/bin/env bash
#
# Runs Fastlane against App Store Connect with an App Store Connect API key (marketing/appstore/README.md).
#
#   marketing/scripts/appstore-fastlane ios preview
#   marketing/scripts/appstore-fastlane ios push
#   marketing/scripts/appstore-fastlane deliver download_metadata --metadata_path …
#   marketing/scripts/appstore-fastlane --exec <command…>
#
# --exec runs a command instead of Fastlane, with the key as xcodebuild's -authenticationKey* options take it:
# ASC_KEY_ID, ASC_ISSUER_ID, and ASC_KEY_P8_PATH, the .p8 in a 0600 temporary file deleted on exit
# (scripts/ios-testflight builds this way, and scripts/release runs under it so 1Password asks only once).
#
# `just appstore-preview|push|pull` drive it. Everything that talks to Apple goes through here, so there's one
# credential path to reason about, and it's an API key, never an Apple ID: an Apple ID means a two-factor code
# typed into a prompt, which no script can supply.
#
# The key comes from the environment, or from marketing/.env.appstore (gitignored), one NAME=value a line:
#
#   ASC_KEY_ID           the key's 10-character ID (also in its file name, AuthKey_<id>.p8)
#   ASC_ISSUER_ID        the team's issuer ID (App Store Connect ▸ Users and Access ▸ Integrations), not in the .p8
#   ASC_KEY_FILE         the path to AuthKey_<id>.p8, outside the repo
#     or ASC_PRIVATE_KEY the .p8's contents, BEGIN and END lines and newlines intact
#
# and App Review's contact, which is personal data and so never in git (Apple asks for all of it whenever the
# review details are written):
#
#   ASC_REVIEW_FIRST_NAME, ASC_REVIEW_LAST_NAME, ASC_REVIEW_EMAIL, ASC_REVIEW_PHONE (e.g. +44 7700 900123)
#
# Or ASC_API_KEY_PATH: a ready-made key JSON for deliver ({key_id, issuer_id, key, …}), used as it is.
#
# Any value can be a 1Password reference (op://vault/item/field): when the file holds one, this reruns itself
# under `op run --env-file`, which resolves them (and asks to unlock). The key JSON is written to a 0600 temporary
# file, deleted on exit, failure included.

set -euo pipefail

self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
# The caller's directory, kept across the rerun under `op run` (which starts from marketing/).
start_dir="${HMK_APPSTORE_START_DIR:-$PWD}"
export HMK_APPSTORE_START_DIR="$start_dir"
cd "$(dirname "$0")/.."

if [ "$#" -eq 0 ]; then
  echo "usage: $(basename "$0") <fastlane args...>" >&2
  exit 2
fi

# Fastlane, checked first, before 1Password is asked for anything: a release runs under --exec from the start
# and uploads through Fastlane only at the end, after its push. In a worktree with none of its own, the main
# checkout's (gems are installed per checkout, `just appstore-install`).
if [ -z "${BUNDLE_PATH:-}" ] && [ ! -d vendor/bundle ]; then
  main_bundle="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)/marketing/vendor/bundle"
  [ -d "$main_bundle" ] && export BUNDLE_PATH="$main_bundle"
fi
if ! bundle check >/dev/null 2>&1; then
  echo >&2 "appstore-fastlane: Fastlane isn't installed. Run: just appstore-install"
  exit 1
fi

env_file="${HMK_APPSTORE_ENV:-.env.appstore}"
if [ ! -f "$env_file" ] && [ -z "${HMK_APPSTORE_ENV:-}" ]; then
  # In a worktree, the main checkout's (one file for every checkout).
  main="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)/marketing/.env.appstore"
  [ -f "$main" ] && env_file="$main"
fi
if [ -f "$env_file" ] && [ -z "${HMK_OP_RESOLVED:-}" ] && grep -q "op://" "$env_file"; then
  if ! command -v op >/dev/null 2>&1; then
    echo >&2 "appstore-fastlane: $env_file has op:// references, but the 1Password CLI (op) isn't installed."
    exit 1
  fi
  # 1Password can't be unlocked on a locked screen: say so now, not after op times out.
  "$(git rev-parse --show-toplevel)/scripts/preflight" screen
  # Only this file's references: `op run` resolves every op:// value it inherits too, and others may be in the
  # environment for other jobs (the justfile loads .release.env, whose 1Password item has no field on purpose).
  others=()
  while IFS='=' read -r name _; do others+=(-u "$name"); done < <(env | grep -E '^[A-Za-z_][A-Za-z0-9_]*=op://' || true)
  exec env ${others[@]+"${others[@]}"} HMK_OP_RESOLVED=1 op run --env-file "$env_file" -- "$self" "$@"
fi
if [ -f "$env_file" ]; then
  # Only what isn't set already: an exported value (or one from `op run`) wins over the file.
  while IFS='=' read -r name value; do
    case "$name" in '' | \#*) continue ;; esac
    name="${name#export }"
    value="${value%\"}"
    value="${value#\"}"
    if [ -z "${!name:-}" ]; then export "$name=$value"; fi
  done <"$env_file"
fi

key_file=""
if [ -z "${ASC_API_KEY_PATH:-}" ]; then
  missing=""
  [ -n "${ASC_KEY_ID:-}" ] || missing="$missing ASC_KEY_ID"
  [ -n "${ASC_ISSUER_ID:-}" ] || missing="$missing ASC_ISSUER_ID"
  if [ -z "${ASC_PRIVATE_KEY:-}" ]; then
    if [ -n "${ASC_KEY_FILE:-}" ]; then
      key_path="${ASC_KEY_FILE/#\~/$HOME}"
      [ -f "$key_path" ] || { echo >&2 "appstore-fastlane: ASC_KEY_FILE is $ASC_KEY_FILE, which isn't a file."; exit 1; }
      ASC_PRIVATE_KEY="$(cat "$key_path")"
    else
      missing="$missing ASC_KEY_FILE(or ASC_PRIVATE_KEY)"
    fi
  fi
  if [ -n "$missing" ]; then
    echo >&2 "appstore-fastlane: no App Store Connect API key. Missing:$missing"
    echo >&2 "  Put them in marketing/.env.appstore (marketing/appstore/README.md, \"The API key\")."
    exit 1
  fi
  case "$ASC_PRIVATE_KEY" in
    *"BEGIN PRIVATE KEY"*) ;;
    *) echo >&2 "appstore-fastlane: the private key doesn't look like a .p8 (no BEGIN PRIVATE KEY line)."; exit 1 ;;
  esac
  key_file="$(mktemp -t hammock-asc-key)"
  chmod 600 "$key_file"
  trap 'rm -f "$key_file"' EXIT INT TERM
  # jq, so the key's newlines are escaped properly. 1200 s is the longest token Apple accepts.
  jq -n --arg key_id "$ASC_KEY_ID" --arg issuer_id "$ASC_ISSUER_ID" --arg key "$ASC_PRIVATE_KEY" \
    '{key_id: $key_id, issuer_id: $issuer_id, key: $key, duration: 1200, in_house: false}' >"$key_file"
  export ASC_API_KEY_PATH="$key_file"
fi
if [ "$1" = --exec ]; then
  shift
  [ "$#" -gt 0 ] || { echo "usage: $(basename "$0") --exec <command...>" >&2; exit 2; }
  ASC_KEY_ID="$(jq -r .key_id "$ASC_API_KEY_PATH")"
  ASC_ISSUER_ID="$(jq -r .issuer_id "$ASC_API_KEY_PATH")"
  p8="$(mktemp -t hammock-asc-p8)"
  chmod 600 "$p8"
  # The key file too, when this script wrote one (not a ready-made ASC_API_KEY_PATH).
  if [ -n "$key_file" ]; then trap 'rm -f "$key_file" "$p8"' EXIT INT TERM; else trap 'rm -f "$p8"' EXIT INT TERM; fi
  jq -r .key "$ASC_API_KEY_PATH" >"$p8"
  export ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_PATH="$p8"
  # Run by the caller's directory, not marketing/. Anything it runs through this script again (scripts/release
  # does) finds HMK_OP_RESOLVED and ASC_API_KEY_PATH set, and asks 1Password for nothing more.
  cd "$start_dir"
  status=0
  "$@" || status=$?
  exit "$status"
fi

# The same path under the name deliver's own option reads, for the `deliver download_*` subcommands.
export DELIVER_API_KEY_PATH="$ASC_API_KEY_PATH"
export ASC_REVIEW_FIRST_NAME="${ASC_REVIEW_FIRST_NAME:-}" ASC_REVIEW_LAST_NAME="${ASC_REVIEW_LAST_NAME:-}"
export ASC_REVIEW_EMAIL="${ASC_REVIEW_EMAIL:-}" ASC_REVIEW_PHONE="${ASC_REVIEW_PHONE:-}"
export FASTLANE_SKIP_UPDATE_CHECK=1 FASTLANE_OPT_OUT_USAGE=1 FASTLANE_HIDE_CHANGELOG=1


status=0
bundle exec fastlane "$@" || status=$?
exit "$status"

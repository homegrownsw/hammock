#!/usr/bin/env bash
#
# Records the App Store's videos from the real iPhone app in the Simulator, and cuts them (marketing/appstore/
# README.md, "The app preview"):
#
#   just appstore-preview-video                # record every take in preview.json, then cut both videos
#   just appstore-preview-video --skip-build   # reuse the last Simulator build
#   just appstore-preview-video --edit-only    # re-cut the last takes (preview.json's edit changed)
#
# Each take launches the Debug app into its demo (DemoMac: made-up, nothing personal) with HMK_DEBUG_TAKE set to
# its steps, which DemoDirector plays, while `simctl io recordVideo` records the screen: on the 6.9" iPhone
# simulator the screenshots use ("Hammock App Store iphone"), from a fresh install, status bar at 9:41. The app
# writes "HammockTake: mark NAME <epoch ms>" for each mark; the script notes when the recording started, so each
# mark becomes seconds into the take. Into marketing/build/takes/: <take>.mov and <take>.json ({marks}).
# Then marketing/scripts/preview/compose.ts cuts the edit into:
#   previews/<locale>/01-hammock-preview.mp4   the app preview: 886 x 1920, 30 fps, a silent sound track
#   creative/<locale>/search-results.mp4       the search results video: 2400 x 1600 (3:2), 30 fps, no sound
# GENERATED and gitignored.

set -euo pipefail

cd "$(dirname "$0")/../.."
root="$PWD"
bundle_id="com.homegrownsw.hammock"
edit="marketing/appstore/preview.json"
derived="marketing/build/DerivedData"
takes_dir="$root/marketing/build/takes"
app="$derived/Build/Products/Debug-iphonesimulator/Hammock.app"

build=1
record=1
for arg in "$@"; do
  case "$arg" in
    --skip-build) build=0 ;;
    --edit-only) build=0; record=0 ;;
    -h | --help) sed -n '2,20p' "$0"; exit 0 ;;
    *) echo >&2 "unknown argument $arg"; exit 2 ;;
  esac
done

now_ms() { perl -MTime::HiRes=time -e 'printf "%d\n", time * 1000'; }

if [ "$record" -eq 1 ]; then
  if [ "$build" -eq 1 ]; then
    echo "==> Building the Debug app for the Simulator"
    just deps >/dev/null
    xcodebuild -project apple/iOS/HammockIOS.xcodeproj -scheme Hammock -configuration Debug \
      -destination "generic/platform=iOS Simulator" -derivedDataPath "$derived" \
      CODE_SIGNING_ALLOWED=NO ARCHS=arm64 ONLY_ACTIVE_ARCH=YES -quiet build
  fi
  [ -d "$app" ] || { echo >&2 "no Simulator build at $app (run without --skip-build)"; exit 1; }

  name="Hammock App Store iphone"
  udid=$(xcrun simctl list devices available -j | jq -r --arg n "$name" '[.devices[][] | select(.name == $n)][0].udid // empty')
  if [ -z "$udid" ]; then
    udid=$(xcrun simctl create "$name" com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro-Max)
  fi
  recorder=""
  cleanup() {
    [ -n "$recorder" ] && kill -INT "$recorder" 2>/dev/null || true
    xcrun simctl terminate "$udid" "$bundle_id" >/dev/null 2>&1 || true
    xcrun simctl status_bar "$udid" clear >/dev/null 2>&1 || true
    xcrun simctl shutdown "$udid" >/dev/null 2>&1 || true
  }
  trap cleanup EXIT
  xcrun simctl list devices booted -j | jq -r '.devices[][].udid' |
    while read -r other; do xcrun simctl shutdown "$other" >/dev/null 2>&1 || true; done
  xcrun simctl boot "$udid" >/dev/null 2>&1 || true
  xcrun simctl bootstatus "$udid" -b >/dev/null
  xcrun simctl status_bar "$udid" override --time 9:41 --dataNetwork wifi --wifiMode active --wifiBars 3 \
    --cellularMode active --cellularBars 4 --operatorName "" --batteryState charged --batteryLevel 100
  mkdir -p "$takes_dir"

  for take in $(jq -r '.takes | keys[]' "$edit"); do
    echo "==> Take $take"
    spec=$(jq -c --arg t "$take" '.takes[$t]' "$edit")
    xcrun simctl ui "$udid" appearance "$(jq -r '.appearance // "dark"' <<<"$spec")"
    xcrun simctl uninstall "$udid" "$bundle_id" >/dev/null 2>&1 || true
    xcrun simctl install "$udid" "$app"
    log="$takes_dir/$take.log" rec_log="$takes_dir/$take.rec.log"
    : >"$log"
    xcrun simctl io "$udid" recordVideo --codec h264 --force "$takes_dir/$take.mov" 2>"$rec_log" &
    recorder=$!
    for _ in $(seq 1 100); do grep -q "Recording started" "$rec_log" 2>/dev/null && break; sleep 0.05; done
    started=$(now_ms)
    env=(SIMCTL_CHILD_HMK_DEBUG_SAMPLE=1 SIMCTL_CHILD_HMK_DEBUG_SCREENSHOT=1
      "SIMCTL_CHILD_HMK_DEBUG_TAKE=$(jq -r '.steps' <<<"$spec")")
    while IFS= read -r e; do env+=("$e"); done < <(jq -r '(.env // {}) | to_entries[] | "SIMCTL_CHILD_\(.key)=\(.value)"' <<<"$spec")
    env "${env[@]}" xcrun simctl launch --terminate-running-process --stderr="$log" "$udid" "$bundle_id" >/dev/null
    for _ in $(seq 1 600); do grep -q "HammockTake: done" "$log" && break; sleep 0.1; done
    grep -q "HammockTake: done" "$log" || { echo >&2 "take $take never finished:"; tail -5 "$log" >&2; exit 1; }
    sleep 0.5
    kill -INT "$recorder"; wait "$recorder" 2>/dev/null || true; recorder=""
    # Each mark, in seconds into this take's recording.
    grep '^HammockTake: mark ' "$log" | awk -v s="$started" '{ printf "%s %.3f\n", $3, ($4 - s) / 1000 }' |
      jq -R -s --arg take "$take" 'split("\n") | map(select(length > 0) | split(" ")) | map({(.[0]): (.[1] | tonumber)}) | add | {take: $take, marks: .}' \
      >"$takes_dir/$take.json"
    echo "    $(jq -c .marks "$takes_dir/$take.json")"
    if grep -q '^HammockTake: unknown step' "$log"; then grep '^HammockTake: unknown step' "$log" >&2; exit 1; fi
  done
fi

echo "==> Cutting the videos"
node --disable-warning=ExperimentalWarning marketing/scripts/preview/compose.ts

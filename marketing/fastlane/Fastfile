# Hammock's App Store listing and TestFlight test information (marketing/appstore/README.md). Run these through
# just, not directly: marketing/scripts/appstore-fastlane resolves the App Store Connect API key and sets
# ASC_API_KEY_PATH.
#
#   just appstore-preview          # read-only: the key, the app record, the versions, the URLs, precheck
#   just appstore-push             # the listing text, screenshots, age rating, review details, What's New, and TestFlight's
#                                  # test information; saves, never submits
#   just appstore-push-testflight  # only TestFlight's test information
#   just appstore-pull             # overwrite marketing/appstore/metadata with what App Store Connect holds
#
# THIS FASTFILE NEVER TOUCHES A BINARY. Builds come from Xcode Cloud (`just release-ios`): `skip_binary_upload`
# is set, and there's no build_app, match or upload_to_testflight here.

fastlane_version "2.238.0"

require "fileutils"
require "net/http"
require "open3"
require "tmpdir"

APP_IDENTIFIER = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

REPO_ROOT = File.expand_path("../..", __dir__)
APPSTORE_DIR = File.expand_path("../appstore", __dir__)
METADATA_PATH = File.join(APPSTORE_DIR, "metadata")
TESTFLIGHT_PATH = File.join(APPSTORE_DIR, "testflight")
REVIEW_NOTES = File.join(METADATA_PATH, "review_information", "notes.txt")
AGE_RATING_PATH = File.join(APPSTORE_DIR, "age_rating.json")
# What's New, per version: marketing/scripts/appstore-whats-new writes whats-new/<version>/<locale>.txt from the
# release notes (gitignored, so it's rebuilt when missing).
WHATS_NEW_PATH = File.join(APPSTORE_DIR, "whats-new")
WHATS_NEW_SCRIPT = File.expand_path("../scripts/appstore-whats-new", __dir__)
VERSION_FILE = File.join(REPO_ROOT, "apple", "iOS", "Config", "Version.xcconfig")
IOS = Spaceship::ConnectAPI::Platform::IOS
# What the listing shows (marketing/appstore/README.md): the marketing images, composed from the screenshots by
# `just appstore-marketing`. marketing/<locale>/ holds the 6.9" iPhone (-iphone69) and 13" iPad (-ipad13) sets,
# which deliver uploads, telling them apart by size; duo/marketing/<locale>/ the iPhone Duo's (-duo), which the
# push uploads itself through the API (deliver has no display type for it yet). Screenshots and their stamps:
SCREENSHOTS_PATH = File.join(APPSTORE_DIR, "marketing")
DUO_PATH = File.join(APPSTORE_DIR, "duo", "marketing")
CAPTURED = { iphone_ipad: File.join(APPSTORE_DIR, "screenshots"), duo: File.join(APPSTORE_DIR, "duo", "screenshots") }.freeze
DUO_DISPLAY_TYPE = "APP_IPHONE_DUO"
# HMK_APPSTORE_SCREENSHOTS=0 leaves every screenshot set as App Store Connect has it; HMK_APPSTORE_DUO=0 the Duo's.
def screenshots?
  ENV["HMK_APPSTORE_SCREENSHOTS"] != "0"
end

def duo?
  screenshots? && ENV["HMK_APPSTORE_DUO"] != "0"
end

# The listing's locales: one directory each under metadata/.
def locales
  Dir[File.join(METADATA_PATH, "*")].select { |p| File.directory?(p) }.map { |p| File.basename(p) }
                                     .reject { |n| n.start_with?("review_", "trade_") }.sort
end

def marketing_version
  File.read(VERSION_FILE)[/^MARKETING_VERSION = ([^\s]+)/, 1]
end

# The key file appstore-fastlane wrote. Checked here so a missing key fails at once, with the fix in the message,
# rather than as deliver's "Could not find app" minutes in.
def asc_api_key_path
  path = ENV["ASC_API_KEY_PATH"].to_s
  return path if !path.empty? && File.exist?(path)
  UI.user_error!("No App Store Connect API key. Run this through `just appstore-preview` / `just appstore-push`, " \
                 "which build it from marketing/.env.appstore (marketing/appstore/README.md).")
end

# App Review's contact: personal data, so it comes from the environment (marketing/.env.appstore), never git.
REVIEW_CONTACT = {
  first_name: "ASC_REVIEW_FIRST_NAME", last_name: "ASC_REVIEW_LAST_NAME",
  email_address: "ASC_REVIEW_EMAIL", phone_number: "ASC_REVIEW_PHONE",
}.freeze

def review_contact
  REVIEW_CONTACT.to_h { |field, env| [field, ENV[env].to_s.strip] }
end

def review_contact_missing
  REVIEW_CONTACT.reject { |field, _| !review_contact[field].empty? }.values
end

def review_notes
  File.read(REVIEW_NOTES).strip
end

def app_record
  Spaceship::ConnectAPI.token ||= Spaceship::ConnectAPI::Token.from_json_file(asc_api_key_path)
  Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
end

def editable_version(app)
  app&.get_edit_app_store_version(platform: IOS)
end

# Text still to be written: anything holding an "[OWNER" placeholder.
def placeholders
  Dir[File.join(APPSTORE_DIR, "{metadata,testflight}", "**", "*.txt")].sort
    .select { |p| File.read(p).include?("[OWNER") }.map { |p| p.delete_prefix("#{APPSTORE_DIR}/") }
end

# What's New for the editable version, from the release notes: [notes by locale, what to say], or [nil, why not].
# A first version has none. For the version the project is building, it's composed from the notes cut for it so
# far and those still pending, so it's right before the version's first build is cut too.
def whats_new_for(app)
  version = editable_version(app)
  return [nil, "What's New: no editable version, nothing to send."] if version.nil?
  if app.get_live_app_store_version(platform: IOS).nil?
    return [nil, "What's New: #{version.version_string} is the first version, which has none. Not sent."]
  end
  v = version.version_string
  args = v == marketing_version ? [v, "--pending"] : [v]
  text, status = Open3.capture2(WHATS_NEW_SCRIPT, *args)
  UI.user_error!("What's New: #{File.basename(WHATS_NEW_SCRIPT)} #{args.join(' ')} failed.") unless status.success?
  text = text.strip
  return [nil, "What's New: no release notes for #{v}, so App Store Connect keeps what it has."] if text.empty?
  UI.user_error!("What's New for #{v} is over 4000 characters (#{text.length}).") if text.length > 4000
  [locales.to_h { |l| [l, text] }, "What's New for #{v} (#{locales.join(', ')}):\n#{text.gsub(/^/, '    ')}"]
end

# The name is what the store lists and what search matches, so a push never changes it by accident.
def name_changes(app)
  info = app.fetch_edit_app_info || app.fetch_live_app_info
  remote = info.nil? ? {} : info.get_app_info_localizations.to_h { |loc| [loc.locale, loc.name] }
  Dir[File.join(METADATA_PATH, "*", "name.txt")].sort.filter_map do |path|
    locale = File.basename(File.dirname(path))
    local = File.read(path).strip
    from = remote[locale] || app.name
    "  #{locale}: \"#{from}\" → \"#{local}\"" unless local == from
  end
end

def deliver_options
  {
    api_key_path: asc_api_key_path,
    app_identifier: APP_IDENTIFIER,
    metadata_path: METADATA_PATH,
    app_rating_config_path: AGE_RATING_PATH,
    skip_binary_upload: true,
    # The iPhone and iPad images; the push empties those sets first (clear_deliver_screenshots!), not deliver's
    # overwrite_screenshots, which would empty the iPhone Duo's too.
    screenshots_path: upload_root,
    overwrite_screenshots: false,
    run_precheck_before_submit: false,
    precheck_include_in_app_purchases: false,
    submit_for_review: false,
    automatic_release: false,
    force: true, # no HTML preview to approve: `preview` is the look first
    # deliver gathers review_information/*.txt into one object and Apple refuses it without a contact, which
    # isn't in git: it's passed here (an option wins over the files, field by field).
    # No demo login: deliver sets "sign-in required" off when there's none.
    app_review_information: review_contact.merge(notes: review_notes),
  }
end

# --- Screenshots: the marketing images (marketing/appstore/README.md).

def image_files(dir, locale, tag)
  Dir[File.join(dir, locale, "*-#{tag}.png")].sort
end

def stamp(path)
  File.exist?(path) ? File.read(path).strip : nil
end

# What deliver uploads: a copy of each listing locale's iPhone and iPad images (deliver turns on a listing locale
# for each folder it's given, so only the listing's own).
def upload_root
  @upload_root ||= begin
    dir = Dir.mktmpdir("hammock-screenshots")
    at_exit { FileUtils.rm_rf(dir) }
    locales.each do |locale|
      from = File.join(SCREENSHOTS_PATH, locale)
      next unless File.directory?(from)
      FileUtils.mkdir_p(File.join(dir, locale))
      (image_files(SCREENSHOTS_PATH, locale, "iphone69") + image_files(SCREENSHOTS_PATH, locale, "ipad13"))
        .each { |f| FileUtils.cp(f, File.join(dir, locale)) }
    end
    dir
  end
end

# Why the images can't be pushed as they are: a set missing or uneven, or composed from a capture other than the
# one on disk (the .captured stamp the compositor copies), or captured for another app version.
def screenshot_problems
  return [] unless screenshots?
  problems = []
  sets = [[SCREENSHOTS_PATH, CAPTURED[:iphone_ipad], %w[iphone69 ipad13]]]
  sets << [DUO_PATH, CAPTURED[:duo], %w[duo]] if duo?
  sets.each do |dir, captured, tags|
    current = stamp(File.join(captured, "en-GB", ".captured"))
    locales.each do |locale|
      counts = tags.to_h { |t| [t, image_files(dir, locale, t).count] }
      where = dir.delete_prefix("#{APPSTORE_DIR}/")
      if counts.values.all?(&:zero?)
        problems << "#{where}/#{locale}/ has no images: run just appstore-screenshots, then just appstore-marketing"
        next
      end
      counts.each { |t, n| problems << "#{where}/#{locale}/ has no -#{t} images" if n.zero? }
      problems << "#{where}/#{locale}/ has sets of different sizes (#{counts.map { |t, n| "#{n} #{t}" }.join(', ')})" if counts.values.uniq.size > 1
      made = stamp(File.join(dir, locale, ".captured"))
      if made != current
        problems << "#{where}/#{locale}/ was composed from an older capture: run just appstore-marketing"
      end
    end
    version = current.to_s[/^version=(.+)$/, 1]
    if version && version != marketing_version
      problems << "#{captured.delete_prefix("#{APPSTORE_DIR}/")} was captured from #{version}, not #{marketing_version}: run just appstore-screenshots"
    end
  end
  problems
end

def duo_set?(set)
  set.screenshot_display_type == DUO_DISPLAY_TYPE
end

# Empties the sets deliver is about to fill, in the locales it uploads to, leaving the iPhone Duo's alone (deliver's
# own overwrite_screenshots would delete every set, the Duo's included). A delete doesn't always stick at once, so
# it tries a few times, then checks.
def clear_deliver_screenshots!(version)
  uploading = locales.select { |l| Dir[File.join(upload_root, l, "*.png")].any? }
  full = lambda do
    version.get_app_store_version_localizations.select { |loc| uploading.include?(loc.locale) }.flat_map do |loc|
      loc.get_app_screenshot_sets.reject { |set| duo_set?(set) || (set.app_screenshots || []).empty? }.map { |set| [loc, set] }
    end
  end
  5.times do
    sets = full.call
    return if sets.empty?
    sets.each do |loc, set|
      UI.message("Clearing #{loc.locale} #{set.screenshot_display_type}")
      set.delete!
    rescue StandardError => e
      UI.error("Couldn't clear #{loc.locale} #{set.screenshot_display_type}: #{e.message}")
    end
  end
  left = full.call
  UI.user_error!("Couldn't clear #{left.map { |loc, set| "#{loc.locale} #{set.screenshot_display_type}" }.join(', ')}.") unless left.empty?
end

# The iPhone Duo set, through the API's APP_IPHONE_DUO: each locale's set is made to hold duo/marketing/<locale>/,
# in filename order. What it holds already (matched by MD5, and not failed at Apple) is kept; the rest is
# deleted and the missing files uploaded. When deliver gains the display type, this can go.
def sync_duo_screenshots!(version)
  return UI.important("iPhone Duo: left as App Store Connect has it (HMK_APPSTORE_DUO=0).") unless duo?
  version.get_app_store_version_localizations.sort_by(&:locale).each do |loc|
    files = image_files(DUO_PATH, loc.locale, "duo")
    next if files.empty?
    set = loc.get_app_screenshot_sets.find { |s| duo_set?(s) } || create_duo_set(loc)
    wanted = files.to_h { |path| [Deliver::UploadScreenshots.calculate_checksum(path), path] }
    held = {}
    (set.app_screenshots || []).each do |shot|
      sum = shot.source_file_checksum
      failed = (shot.asset_delivery_state || {})["state"] == "FAILED"
      if sum && wanted.key?(sum) && !held.key?(sum) && !failed
        held[sum] = shot
      else
        shot.delete!
      end
    end
    missing = wanted.reject { |sum, _| held.key?(sum) }
    missing.each do |sum, path|
      UI.message("Uploading #{File.basename(path)} (#{loc.locale} iPhone Duo)")
      held[sum] = set.upload_screenshot(path: path, wait_for_processing: true)
    rescue StandardError => e
      UI.user_error!("App Store Connect didn't take #{File.basename(path)} (#{loc.locale} iPhone Duo): #{e.message}. " \
                     "The next push tries again.")
    end
    set.reorder_screenshots(app_screenshot_ids: wanted.keys.map { |sum| held[sum].id })
    UI.success("iPhone Duo (#{loc.locale}): #{wanted.count} screenshot(s), #{missing.count} of them new.")
  end
end

def create_duo_set(loc)
  loc.create_app_screenshot_set(attributes: { screenshotDisplayType: DUO_DISPLAY_TYPE })
rescue StandardError => e
  UI.user_error!("App Store Connect refused an iPhone Duo screenshot set for #{loc.locale}: #{e.message}\n" \
                 "  Everything before it is uploaded. Drag duo/marketing/#{loc.locale}/ in by hand, and push without " \
                 "it meanwhile: HMK_APPSTORE_DUO=0 just appstore-push")
end

# --- TestFlight's test information: each locale's Beta App Description, feedback email and URLs, and the Beta App
# Review details (the same contact and notes as the App Store's). deliver doesn't do these, so Spaceship does.

def testflight_text(locale, file)
  path = File.join(TESTFLIGHT_PATH, locale, file)
  File.exist?(path) ? File.read(path).strip : nil
end

def testflight_locales
  Dir[File.join(TESTFLIGHT_PATH, "*")].select { |p| File.directory?(p) }.map { |p| File.basename(p) }.sort
end

def testflight_wanted
  testflight_locales.to_h do |locale|
    [locale, {
      description: testflight_text(locale, "description.txt"),
      feedback_email: ENV["ASC_REVIEW_EMAIL"].to_s.strip,
      marketing_url: testflight_text(locale, "marketing_url.txt"),
      privacy_policy_url: testflight_text(locale, "privacy_url.txt"),
    }.compact]
  end
end

def testflight_review_wanted
  c = review_contact
  {
    contact_first_name: c[:first_name], contact_last_name: c[:last_name],
    contact_email: c[:email_address], contact_phone: c[:phone_number],
    demo_account_required: false, notes: review_notes,
  }
end

# What a TestFlight push would change, field by field (read-only).
def testflight_changes(app)
  have = app.get_beta_app_localizations.to_h { |l| [l.locale, l] }
  changes = testflight_wanted.flat_map do |locale, want|
    loc = have[locale]
    next ["  #{locale}: new (#{want.keys.join(', ')})"] if loc.nil?
    want.filter_map { |k, v| "  #{locale}: #{k}" unless loc.public_send(k).to_s.strip == v }
  end
  detail = Spaceship::ConnectAPI.get_beta_app_review_detail(filter: { app: app.id }).first
  testflight_review_wanted.each do |k, v|
    changes << "  review: #{k}" unless detail && detail.public_send(k).to_s.strip == v.to_s
  end
  changes
end

def push_testflight!(app)
  have = app.get_beta_app_localizations.to_h { |l| [l.locale, l] }
  testflight_wanted.each do |locale, want|
    attrs = want.transform_keys { |k| k.to_s.gsub(/_(\w)/) { Regexp.last_match(1).upcase } }
    if (loc = have[locale])
      Spaceship::ConnectAPI.patch_beta_app_localizations(localization_id: loc.id, attributes: attrs)
    else
      Spaceship::ConnectAPI.post_beta_app_localizations(app_id: app.id, attributes: attrs.merge("locale" => locale))
    end
    UI.success("TestFlight: #{locale} test information")
  end
  attrs = testflight_review_wanted.transform_keys { |k| k.to_s.gsub(/_(\w)/) { Regexp.last_match(1).upcase } }
  Spaceship::ConnectAPI.patch_beta_app_review_detail(app_id: app.id, attributes: attrs)
  UI.success("TestFlight: Beta App Review details")
end

def fetch_status(url, redirects_left: 5)
  uri = URI(url)
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: 10, read_timeout: 10) do |h|
    h.request(Net::HTTP::Get.new(uri))
  end
  return res.code.to_i unless res.is_a?(Net::HTTPRedirection) && redirects_left.positive?
  fetch_status(URI.join(url, res["location"]).to_s, redirects_left: redirects_left - 1)
rescue StandardError => e
  "#{e.class}: #{e.message}"
end

def preflight_problems
  problems = placeholders.map { |f| "#{f} still has an [OWNER …] placeholder." }
  missing = review_contact_missing
  problems << "App Review's contact isn't set: #{missing.join(', ')} (marketing/.env.appstore)." unless missing.empty?
  problems += screenshot_problems.map { |p| "Screenshots: #{p}" }
  problems
end

platform :ios do
  # Read-only. Not `deliver(verify_only: true)`: that verifies a binary and never reaches the metadata.
  desc "Read-only preflight: the key, the app record, the versions, What's New, TestFlight, the URLs, precheck"
  lane :preview do
    problems = preflight_problems
    app = app_record
    if app.nil?
      problems << "App Store Connect has no app with the bundle id #{APP_IDENTIFIER}."
    else
      UI.success("App: #{app.name} (#{app.id}), primary language #{app.primary_locale}")
      changes = name_changes(app)
      UI.important("A push would RENAME the app:\n#{changes.join("\n")}") unless changes.empty?
      version = editable_version(app)
      if version.nil?
        problems << "There's no editable App Store version for a push to write to: add one in App Store Connect."
      else
        UI.success("Editable version: #{version.version_string} (#{version.app_store_state})")
        UI.message(whats_new_for(app).last)
      end
      tf = testflight_changes(app)
      UI.message(tf.empty? ? "TestFlight: up to date." : "TestFlight: a push would change\n#{tf.join("\n")}")
      if screenshots?
        counts = locales.map { |l| "#{l} #{image_files(SCREENSHOTS_PATH, l, "iphone69").count} iPhone, #{image_files(SCREENSHOTS_PATH, l, "ipad13").count} iPad, #{duo? ? image_files(DUO_PATH, l, "duo").count : "(left alone)"} iPhone Duo" }
        UI.message("Screenshots a push would upload: #{counts.join("; ")}")
      end
    end

    Dir[File.join(APPSTORE_DIR, "{metadata,testflight}", "*", "*_url.txt")].map { |p| File.read(p).strip }
      .reject(&:empty?).uniq.sort.each do |url|
      code = fetch_status(url)
      if code == 200
        UI.success("#{code}  #{url}")
      else
        problems << "#{url} returned #{code}. App Review opens every one of these."
      end
    end

    if app
      precheck(app_identifier: APP_IDENTIFIER, api_key_path: asc_api_key_path,
               include_in_app_purchases: false, default_rule_level: :warn)
    end

    UI.user_error!("Preflight found #{problems.count} problem(s):\n  - #{problems.join("\n  - ")}") unless problems.empty?
    UI.success("Preflight passed. Nothing was uploaded: `just appstore-push` does that.")
  end

  desc "Upload the listing text, age rating, review details, What's New and TestFlight's test information. " \
       "Saves; never submits, never a binary."
  lane :push do
    # Everything that could fail part-way is refused before anything is sent.
    problems = preflight_problems
    UI.user_error!("Not ready:\n  - #{problems.join("\n  - ")}") unless problems.empty?
    app = app_record
    UI.user_error!("App Store Connect has no app with the bundle id #{APP_IDENTIFIER}.") if app.nil?
    changes = name_changes(app)
    if !changes.empty? && ENV["HMK_APPSTORE_ALLOW_RENAME"] != "1"
      UI.user_error!("Refusing to rename the app:\n#{changes.join("\n")}\n" \
                     "  Keep the store's name: edit metadata/<locale>/name.txt\n" \
                     "  Rename on purpose:     HMK_APPSTORE_ALLOW_RENAME=1 just appstore-push")
    end
    UI.user_error!("There's no editable App Store version to upload to: add one in App Store Connect.") if editable_version(app).nil?

    options = deliver_options
    notes, said = whats_new_for(app)
    UI.message(said)
    options[:release_notes] = notes if notes
    version = editable_version(app)
    # The text first, then the screenshots: deliver validates the text as it goes, so a refusal never leaves the
    # listing with its screenshot sets already emptied.
    deliver(options.merge(skip_screenshots: true))
    if screenshots?
      clear_deliver_screenshots!(version)
      deliver(options.merge(skip_metadata: true))
      sync_duo_screenshots!(version)
    else
      UI.important("Screenshots: left as App Store Connect has them (HMK_APPSTORE_SCREENSHOTS=0).")
    end
    push_testflight!(app)
    UI.success("Uploaded. Saved in App Store Connect, NOT submitted for review.")
  end

  desc "Upload only TestFlight's test information (descriptions, feedback email, Beta App Review details)"
  lane :push_testflight do
    missing = review_contact_missing
    UI.user_error!("App Review's contact isn't set: #{missing.join(', ')} (marketing/.env.appstore).") unless missing.empty?
    app = app_record
    UI.user_error!("App Store Connect has no app with the bundle id #{APP_IDENTIFIER}.") if app.nil?
    push_testflight!(app)
    UI.success("Uploaded TestFlight's test information. Nothing was submitted.")
  end
end

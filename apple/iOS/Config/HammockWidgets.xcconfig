// The widget extension's build settings (both configurations): the Live
// Activity (Lock Screen and Dynamic Island) and the Needs You widget. It
// reads what the app and the notification extension keep in the App Group
// (HammockWidgets.entitlements); it makes no connections of its own.

#include "Version.xcconfig"
MARKETING_VERSION = $(HAMMOCK_IOS_VERSION)

PRODUCT_BUNDLE_IDENTIFIER = com.homegrownsw.hammock.widgets
SWIFT_VERSION = 5.0
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Hammock

<?php
/* Hammock's page: everything here is an hmk command (include/action.php),
 * so a server without Unraid does the same with hmk. */
$hammock_cfg = array_merge(['FOLDER' => '/mnt/user/appdata/hammock', 'AUTOSTART' => 'yes', 'PANE_HOME' => 'folder'],
  @parse_ini_file('/boot/config/plugins/hammock/hammock.cfg') ?: []);
?>
<style>
#hammock .hm-section { margin: 0 0 28px; }
#hammock h3 { margin: 18px 0 8px; font-size: 1.15em; }
#hammock .hm-muted { opacity: .7; }
#hammock .hm-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; vertical-align: middle; background: #999; }
#hammock .hm-dot.on { background: #3c9d3c; }
#hammock .hm-dot.off { background: #c0392b; }
#hammock table.hm { width: 100%; max-width: 900px; border-collapse: collapse; }
#hammock table.hm td, #hammock table.hm th { padding: 6px 10px 6px 0; text-align: left; vertical-align: middle; }
#hammock table.hm th { font-weight: 600; }
#hammock .hm-code { font: 600 2em/1.2 monospace; letter-spacing: .1em; }
#hammock .hm-box { border: 1px solid rgba(128,128,128,.4); border-radius: 6px; padding: 12px 16px; margin: 10px 0; max-width: 860px; }
#hammock .hm-qr { background: #fff; padding: 8px; border-radius: 6px; width: 240px; height: 240px; image-rendering: pixelated; }
#hammock .hm-link { font: .85em monospace; word-break: break-all; }
#hammock .hm-error { color: #c0392b; }
#hammock input[type=text] { width: 360px; max-width: 100%; }
</style>

<div id="hammock">
  <div class="hm-section">
    <h3>Hammock</h3>
    <p class="hm-muted">Terminal sessions and agents that live on this server. Link it to your Mac to see its Groups there, and pair your iPhone to hear when an agent needs you.</p>
    <table class="hm">
      <tr><th style="width:180px">Status</th><td id="hm-status"><span class="hm-dot"></span>Checking…</td></tr>
      <tr><th>Sessions</th><td id="hm-counts">–</td></tr>
      <tr><th>Version</th><td id="hm-version">–</td></tr>
    </table>
    <p>
      <input type="button" id="hm-start" value="Start" onclick="hammockDo('start')">
      <input type="button" id="hm-stop" value="Stop" onclick="hammockDo('stop')" title="Stops the daemon. Panes keep running.">
      <input type="button" id="hm-restart" value="Restart" onclick="hammockDo('restart')" title="Panes keep running.">
      <input type="button" id="hm-tui" value="Open Hammock" onclick="hammockTUI()" title="Hammock's terminal UI (hmk tui) in a window">
    </p>
    <p id="hm-error" class="hm-error"></p>
  </div>

  <div class="hm-section">
    <h3>Settings</h3>
    <table class="hm">
      <tr><th style="width:180px">Hammock folder</th>
        <td><input type="text" id="hm-folder" value="<?=htmlspecialchars($hammock_cfg['FOLDER'])?>">
        <div class="hm-muted">Its state, and what your panes keep across reboots. Unraid's own home is emptied at every reboot.</div></td></tr>
      <tr><th>Panes' home (~)</th>
        <td><select id="hm-panehome">
          <option value="folder" <?=$hammock_cfg['PANE_HOME']!=='root'?'selected':''?>>In the Hammock folder</option>
          <option value="root" <?=$hammock_cfg['PANE_HOME']==='root'?'selected':''?>>Unraid's /root</option>
        </select>
        <div class="hm-muted">In the Hammock folder, dotfiles, history and Claude Code itself are kept there. /root is for a server whose own set-up already keeps them (a <i>go</i> script linking them to a share): Hammock then keeps only ~/.claude, ~/.claude.json and ~/.codex in its folder. Panes run root's own shell either way.</div></td></tr>
      <tr><th>Start with the array</th>
        <td><select id="hm-autostart">
          <option value="yes" <?=$hammock_cfg['AUTOSTART']==='yes'?'selected':''?>>Yes</option>
          <option value="no" <?=$hammock_cfg['AUTOSTART']!=='yes'?'selected':''?>>No</option>
        </select>
        <div class="hm-muted">When the array stops, Hammock stops and its panes end. They come back when it starts: layout, folders, scrollback, and agents resumed.</div></td></tr>
    </table>
    <p><input type="button" value="Apply" onclick="hammockSave()"></p>
  </div>

  <div class="hm-section" id="hm-running-only">
    <h3>Remote access</h3>
    <p class="hm-muted">Your Mac and iPhone reach this server only on the networks chosen here. Tailscale works from anywhere.</p>
    <p><label><input type="checkbox" id="hm-remote" onchange="hammockRemote(this.checked)"> Allow linked computers and paired devices</label></p>
    <table class="hm" id="hm-networks"></table>

    <h3>Linked computers</h3>
    <p class="hm-muted">Each linked computer shows this server's Groups, and this one shows theirs.</p>
    <table class="hm" id="hm-computers"></table>
    <p><input type="button" value="Link a Computer…" onclick="hammockLink()"></p>
    <div id="hm-link" class="hm-box" style="display:none"></div>

    <h3>Paired devices</h3>
    <p class="hm-muted">Your iPhone, paired here, gets a notification when an agent on this server needs you and you're away from your Macs.</p>
    <table class="hm" id="hm-devices"></table>
    <p><input type="button" value="Pair a Device…" onclick="hammockPair()"></p>
    <div id="hm-pair" class="hm-box" style="display:none"></div>
  </div>
</div>

<script>
var hammockLinking = 0;

function hammockPost(action, data) {
  return $.post('/plugins/hammock/include/action.php', $.extend({action: action, csrf_token: csrf_token}, data || {}))
    .fail(function(x) {
      var e = (x.responseJSON && x.responseJSON.error) || x.statusText || 'Something went wrong';
      $('#hm-error').text(e);
    });
}

// What hmk reports (computer and device names, link requests, networks)
// comes from other machines: it goes into the page only as text, through
// these, never into HTML or an inline handler.
function hmText(s) { return s == null ? '' : String(s); }
function hmEl(tag, cls, text) {
  var e = $(document.createElement(tag));
  if (cls) e.addClass(cls);
  if (text != null) e.text(hmText(text));
  return e;
}
function hmCell(width /*, content… */) {
  var td = $('<td>');
  if (width) td.css('width', width);
  for (var i = 1; i < arguments.length; i++) td.append(arguments[i]);
  return td;
}
function hmButton(label, onClick) {
  return $('<input type="button">').val(label).on('click', onClick);
}
function hmNone() { return $('<tr>').append(hmEl('td', 'hm-muted', 'None yet.')); }

function hmWhen(ms) {
  ms = Number(ms || 0);
  if (!ms) return '';
  var d = new Date(ms);
  return d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'});
}

function hammockRefresh() {
  hammockPost('status').done(function(st) {
    $('#hm-error').text('');
    var on = !!st.running;
    $('#hm-status').empty().append(hmEl('span', 'hm-dot ' + (on ? 'on' : 'off')),
      on ? [document.createTextNode('Running as '), hmEl('b', null, st.name)] :
        document.createTextNode(st.array_started || !st.config.FOLDER.startsWith('/mnt/') ? 'Stopped' : 'Stopped: it starts with the array'),
      document.createTextNode(' '), hmEl('span', 'hm-muted', '(' + hmText(st.dir) + ')'));
    $('#hm-counts').text(on ? st.groups + ' Groups, ' + st.tabs + ' tabs, ' + st.panes + ' panes, ' + st.agents + ' agents' +
      (st.needs_you ? ', ' + st.needs_you + ' need you' : '') : '–');
    $('#hm-version').text(st.version || '–');
    $('#hm-start').prop('disabled', on);
    $('#hm-stop, #hm-restart, #hm-tui').prop('disabled', !on);
    $('#hm-running-only').toggle(on);
    if (!on) return;

    $('#hm-remote').prop('checked', !!st.remote_enabled);
    var nets = (st.networks || []).map(function(n) {
      var id = hmText(n.id);
      var box = $('<input type="checkbox">').prop('checked', !!n.chosen)
        .on('change', function() { hammockNetwork(id, this.checked); });
      var where = n.connected ? hmEl('span', null, (n.addresses || []).join(', ')) : hmEl('span', 'hm-muted', 'not on it now');
      return $('<tr>').append(hmCell('30px', box),
        hmCell('200px', hmEl('span', null, n.label && n.label !== n.id ? n.label + ' (' + id + ')' : id)),
        hmCell(null, where, n.public ? ' ' : '',
          n.public ? hmEl('span', 'hm-error', 'a public address: anyone who can reach it could try to connect') : ''));
    });
    $('#hm-networks').empty().append(nets);

    var comps = (st.computers || []).filter(function(c) { return !c.this_computer; }).map(function(c) {
      var state = c.refused ? 'doesn’t link with this one any more' : c.cert_changed ? 'its certificate changed' :
        c.online ? 'online' : (Number(c.last_seen_unix_ms) ? 'last seen ' + hmWhen(c.last_seen_unix_ms) : 'offline');
      var id = hmText(c.user_id), name = hmText(c.name);
      return $('<tr>').append(hmCell('200px', hmEl('b', null, name)), hmCell('160px', hmEl('span', null, c.model || c.os)),
        hmCell(null, hmEl('span', null, state)),
        hmCell('90px', hmButton('Unlink', function() { hammockUnlink(id, name); })));
    });
    $('#hm-computers').empty().append(comps.length ? comps : hmNone());

    var devs = (st.devices || []).map(function(d) {
      var id = hmText(d.id);
      return $('<tr>').append(hmCell('200px', hmEl('b', null, d.name)), hmCell('160px', hmEl('span', null, d.platform)),
        hmCell(null, hmEl('span', null, 'paired ' + hmWhen(d.paired_unix_ms) + ', last seen ' + hmWhen(d.last_seen_unix_ms))),
        hmCell('90px', hmButton('Revoke', function() { hammockRevoke(id); })));
    });
    $('#hm-devices').empty().append(devs.length ? devs : hmNone());

    hammockShowRequests(st.link_requests || [], st.name);
  });
}

function hammockDo(action) {
  $('#hm-start, #hm-stop, #hm-restart').prop('disabled', true);
  hammockPost(action).always(hammockRefresh);
}

function hammockSave() {
  hammockPost('save', {folder: $('#hm-folder').val(), autostart: $('#hm-autostart').val(), pane_home: $('#hm-panehome').val()}).done(function(r) {
    $('#hm-error').text(r.restarted ? 'Hammock restarted. New panes use the new settings; panes already open keep theirs until they’re closed.' : '');
    hammockRefresh();
  });
}

function hammockRemote(on) { hammockPost('remote', {on: on ? 'yes' : 'no'}).always(hammockRefresh); }
function hammockNetwork(id, chosen) { hammockPost('network', {id: id, chosen: chosen ? 'yes' : 'no'}).always(hammockRefresh); }

function hammockUnlink(id, name) {
  swal({title: 'Unlink ' + name + '?', html: false, text: 'It’s unlinked from all your computers, and can be linked again only with a code check.',
    type: 'warning', showCancelButton: true, confirmButtonText: 'Unlink'}, function(ok) {
    if (ok) hammockPost('unlink', {id: id}).always(hammockRefresh);
  });
}

function hammockRevoke(id) { hammockPost('revoke', {id: id}).always(hammockRefresh); }

// Linking: this server lets computers ask for ten minutes, and shows each
// one's code to check against the code on the Mac.
function hammockLink() {
  hammockPost('link_invite').done(function(r) {
    hammockLinking = Date.now() + 10 * 60 * 1000;
    $('#hm-link').show().html('<p>On your Mac, open <b>Hammock ▸ Link a Computer…</b> and choose this server. ' +
      'If it isn’t listed, paste this link there:</p><p class="hm-link" id="hm-link-url"></p>' +
      '<p class="hm-muted" id="hm-link-wait">Waiting for your Mac to ask…</p><div id="hm-link-reqs"></div>');
    $('#hm-link-url').text(hmText(r.link));
    hammockRefresh();
  });
}

function hammockShowRequests(reqs, myName) {
  if (!reqs.length && !hammockLinking) { $('#hm-link').hide(); return; }
  if (!reqs.length) return;
  $('#hm-link').show();
  if (!$('#hm-link-reqs').length) $('#hm-link').html('<div id="hm-link-reqs"></div>');
  $('#hm-link-wait').hide();
  var list = $('#hm-link-reqs').empty();
  reqs.forEach(function(r) {
    var id = hmText(r.id);
    var from = r.tailscale_host ? 'Tailscale ' + r.tailscale_host + (r.tailscale_login ? ' (' + r.tailscale_login + ')' : '') : (r.from || '');
    var who = $('<p>').append(hmEl('b', null, r.name), ' ', hmEl('span', null, r.model || r.os || ''));
    if (from) who.append(' ', hmEl('span', 'hm-muted', 'from ' + from));
    if (r.unlinked_unix_ms) {
      who.append('<br>', hmEl('span', 'hm-error', 'You unlinked it on ' + hmWhen(r.unlinked_unix_ms) +
        ' (lost or stolen?). Link it again only if it’s back with you.'));
    }
    list.append(who, '<p>Does your Mac show this code?</p>', hmEl('p', 'hm-code', r.code),
      $('<p>').append(hmButton('They Match', function() { hammockAnswer(id, true); }), ' ',
        hmButton('They Don’t', function() { hammockAnswer(id, false); })));
  });
}

function hammockAnswer(id, ok) {
  hammockPost(ok ? 'link_confirm' : 'link_refuse', {id: id}).done(function() {
    hammockLinking = 0;
    $('#hm-link').html(ok ? '<p>Linked once your Mac says they match too. Its Groups show here, and this server’s on your Mac.</p>' : '<p>Refused.</p>');
    setTimeout(function() { $('#hm-link').hide(); }, 8000);
  }).always(hammockRefresh);
}

function hammockPair() {
  hammockPost('pair').done(function(p) {
    $('#hm-pair').show().html('<p>In Hammock on your iPhone: <b>Devices ▸ Add Computer</b>, then scan this code. It works once, for ten minutes.</p>' +
      '<img class="hm-qr" alt="Pairing code">' +
      (p.remote_enabled ? '' : '<p class="hm-error">Remote access is off: turn it on above, or the iPhone can’t reach this server.</p>') +
      '<p class="hm-muted">Or paste it there:</p><p class="hm-link" id="hm-pair-link"></p>');
    $('#hm-pair .hm-qr').attr('src', 'data:image/png;base64,' + String(p.qr_png || '').replace(/[^A-Za-z0-9+\/=]/g, ''));
    $('#hm-pair-link').text(hmText(p.link));
    setTimeout(function() { $('#hm-pair').hide().empty(); hammockRefresh(); }, 10 * 60 * 1000);
  });
}

function hammockTUI() {
  var w = window.open('', 'hammock', 'width=1200,height=800');
  hammockPost('tui').done(function(r) { setTimeout(function() { w.location = r.url; w.focus(); }, 300); })
    .fail(function() { w.close(); });
}

$(function() {
  hammockRefresh();
  // Often enough that a link request's code shows soon after your Mac asks.
  setInterval(function() {
    if (hammockLinking && Date.now() > hammockLinking) hammockLinking = 0;
    if (!document.hidden) hammockRefresh();
  }, 2500);
});
</script>

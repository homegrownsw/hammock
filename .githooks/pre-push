#!/usr/bin/env bash
# Keeps a release's own commit off GitHub until scripts/release pushes it. scripts/release commits
# "release: …" on main, builds for a long while, then pushes; if it fails it takes the commit back. A push from
# anywhere else in that window (another session sharing the checkout, a worktree fast-forwarded onto main)
# would publish a release that never happened. So, unless it's scripts/release pushing (HMK_RELEASING=1):
#   - nothing containing a "release: " commit that origin doesn't have yet goes out;
#   - nothing goes to main while a release is running (its lock in the git dir, with a live PID).
# Installed by `just deps` and `just worktree` (core.hooksPath = .githooks).
set -euo pipefail
[ "${HMK_RELEASING:-}" = 1 ] && exit 0

remote="$1"
zero=0000000000000000000000000000000000000000
lock="$(git rev-parse --git-common-dir)/hammock-release.lock"
running=""
if [ -f "$lock" ]; then
  pid="$(cat "$lock" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then running="$pid"; fi
fi

status=0
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a delete
  if [ -n "$running" ] && [ "$remote_ref" = refs/heads/main ]; then
    echo "pre-push: a release is running (scripts/release, PID $running): don't push main until it's done." >&2
    status=1
    continue
  fi
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
    range=("$local_sha" --not "--remotes=$remote")
  else
    range=("$remote_sha..$local_sha")
  fi
  rel="$(git log --format='%h %s' "${range[@]}" | grep -E '^[0-9a-f]+ release: ' || true)"
  if [ -n "$rel" ]; then
    echo "pre-push: refusing to push a release commit that only scripts/release may push:" >&2
    echo "$rel" | sed 's/^/  /' >&2
    echo "It's left over from a release that's running or failed. Rebase your work onto origin/main without it" >&2
    echo "(git rebase --onto origin/main <release commit>), or ask the person running the release." >&2
    status=1
  fi
done
exit $status

#!/usr/bin/env bash
# Tests for release notes and release cuts (release-notes/README.md): `just test-release`.
#
#   scripts/note, scripts/note-check   writing notes and requiring them
#   scripts/release                    freezing the notes into a release, its tags and number, each app's
#                                      version, and taking everything back when a step fails
#   scripts/version                    showing and setting the versions
#
# The release script runs for real, against throwaway repos with a bare remote (it commits, tags and
# pushes), with stand-ins for scripts/mac-update and scripts/ios-testflight so nothing is built, notarized
# or uploaded.
set -euo pipefail

cd "$(dirname "$0")/../.."
REPO="$PWD"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# The stand-in for scripts/mac-update: records each call (and the notes it was given), and fails a build
# when FAKE_BUILD_FAIL=1 or an upload when FAKE_UPLOAD_FAIL=1.
cat >"$tmp/mac-update" <<EOF
#!/usr/bin/env bash
echo "\$1 \$2" >>"$tmp/mac-update.log"
if [ "\$1" = build ]; then cp "\$3" "$tmp/notes.html"; [ "\${FAKE_BUILD_FAIL:-}" != 1 ] || exit 1; fi
if [ "\$1" = upload ]; then [ "\${FAKE_UPLOAD_FAIL:-}" != 1 ] || exit 1; fi
exit 0
EOF
chmod +x "$tmp/mac-update"
export HMK_RELEASE_MAC_UPDATE="$tmp/mac-update"
# The same for scripts/ios-testflight, into the same log as "ios <step> <n>": FAKE_IOS_BUILD_FAIL=1 fails a
# build, FAKE_IOS_UPLOAD_FAIL=1 an upload.
cat >"$tmp/ios-testflight" <<EOF
#!/usr/bin/env bash
echo "ios \$1 \$2" >>"$tmp/mac-update.log"
if [ "\$1" = build ]; then [ "\${FAKE_IOS_BUILD_FAIL:-}" != 1 ] || exit 1; fi
if [ "\$1" = upload ]; then [ "\${FAKE_IOS_UPLOAD_FAIL:-}" != 1 ] || exit 1; fi
exit 0
EOF
chmod +x "$tmp/ios-testflight"
export HMK_RELEASE_IOS_TESTFLIGHT="$tmp/ios-testflight"
# And for scripts/android-apk, as "android <step> <n>": FAKE_ANDROID_BUILD_FAIL=1 fails a build, and the
# notes it was given go to $tmp/android-notes.html.
cat >"$tmp/android-apk" <<EOF
#!/usr/bin/env bash
echo "android \$1 \$2" >>"$tmp/mac-update.log"
if [ "\$1" = build ]; then cp "\$3" "$tmp/android-notes.html"; [ "\${FAKE_ANDROID_BUILD_FAIL:-}" != 1 ] || exit 1; fi
exit 0
EOF
chmod +x "$tmp/android-apk"
export HMK_RELEASE_ANDROID_APK="$tmp/android-apk"
# And for scripts/site-deploy, into a log of its own: FAKE_SITE_FAIL=1 fails it.
cat >"$tmp/site-deploy" <<EOF
#!/usr/bin/env bash
echo "\$*" >>"$tmp/site.log"
[ "\${FAKE_SITE_FAIL:-}" != 1 ] || exit 1
EOF
chmod +x "$tmp/site-deploy"
export HMK_RELEASE_SITE_DEPLOY="$tmp/site-deploy"
deploys() { cat "$tmp/site.log" 2>/dev/null || true; rm -f "$tmp/site.log"; }
export HMK_RELEASE_YEAR=2026
# Outside a pane, so a release's review of its notes isn't opened beside this one (scripts/release-review).
unset HMK_PANE_ID
calls() { cat "$tmp/mac-update.log" 2>/dev/null || true; rm -f "$tmp/mac-update.log"; }

pass=0
fail=0
check() { # check <label> <expected> <actual>
  if [ "$2" = "$3" ]; then
    echo "  ok   $1"
    pass=$((pass + 1))
  else
    echo "  FAIL $1: expected '$2', got '$3'"
    fail=$((fail + 1))
  fi
}
contains() { if printf '%s' "$2" | grep -qF -- "$1"; then echo yes; else echo no; fi; }

# A throwaway repo shaped just enough like this one: the scripts, Version.xcconfig, and pending notes for
# each app (one for people to read, one INTERNAL).
fixture() { # fixture <version> [ios version]
  local dir="$tmp/repo-$RANDOM$RANDOM"
  mkdir -p "$dir"/{scripts/lib,apple/iOS/Config,marketing,release-notes/mac/pending,release-notes/ios/pending,release-notes/android/pending}
  cp "$REPO"/scripts/{release,release-review,note,note-check,version,commit-number} "$dir/scripts/"
  echo 0 >"$dir/scripts/history-commits"
  cp "$REPO/scripts/lib/release-notes.sh" "$dir/scripts/lib/"
  printf 'HAMMOCK_MAC_VERSION = %s\nHAMMOCK_IOS_VERSION = %s\nHAMMOCK_ANDROID_VERSION = %s\nCURRENT_PROJECT_VERSION = 0\n' "$1" "${2:-$1}" "${3:-$1}" \
    >"$dir/apple/iOS/Config/Version.xcconfig"
  for p in mac ios android; do
    printf 'tag: FIXED\ndate: 2026-11-01\nA <thing> & more works now.\n' >"$dir/release-notes/$p/pending/1-a-thing.md"
    printf 'tag: NEW\ndate: 2026-11-01\nA new thing.\n' >"$dir/release-notes/$p/pending/new-thing.md"
    printf 'tag: INTERNAL\ndate: 2026-11-01\nPlumbing.\n' >"$dir/release-notes/$p/pending/plumbing.md"
  done
  git -C "$dir" init -q -b main
  git -C "$dir" config user.email t@example.com
  git -C "$dir" config user.name Test
  git -C "$dir" add -A
  git -C "$dir" commit -qm initial
  git init -q --bare "$dir.remote"
  git -C "$dir" remote add origin "$dir.remote"
  git -C "$dir" push -q -u origin main
  echo "$dir"
}
count() { git -C "$1" rev-list --count "${2:-HEAD}"; }
remote_tags() { git -C "$1.remote" tag -l | tr '\n' ' ' | sed 's/ $//'; }
release() { (cd "$1" && ./scripts/release "${@:2}" >/dev/null 2>&1); }
ver() { git -C "$1" show "${3:-HEAD}:apple/iOS/Config/Version.xcconfig" | sed -nE "s/^HAMMOCK_$2_VERSION = (.*)/\\1/p"; }
# A release of a version already cut (its tag), as if from an earlier run.
mark_released() { git -C "$1" tag "$2-v$3-r1" "$(git -C "$1" rev-list --max-parents=0 HEAD)"; git -C "$1" push -q origin "$2-v$3-r1"; }

echo "notes:"
d=$(fixture 2026.1.0)
(cd "$d" && ./scripts/note mac fixed "It's fixed (really)." >/dev/null)
check "a Mac note" "tag: FIXED" "$(head -n1 "$d/release-notes/mac/pending/it-s-fixed-really.md" 2>/dev/null)"
check "keeps the text as written" "It's fixed (really)." "$(tail -n1 "$d/release-notes/mac/pending/it-s-fixed-really.md")"
check "…and not for iOS" "no" "$([ -e "$d/release-notes/ios/pending/it-s-fixed-really.md" ] && echo yes || echo no)"
(cd "$d" && ./scripts/note both new 44 "Both apps." >/dev/null)
check "both apps, with the issue" "yes yes" "$([ -e "$d/release-notes/mac/pending/44-both-apps.md" ] && echo yes) $([ -e "$d/release-notes/ios/pending/44-both-apps.md" ] && echo yes)"
(cd "$d" && ./scripts/note both new 44 "Both apps." >/dev/null)
check "a second with the same name gets -2" "yes" "$([ -e "$d/release-notes/ios/pending/44-both-apps-2.md" ] && echo yes)"
git -C "$d" checkout -q -b alex/77-thing
(cd "$d" && ./scripts/note ios internal "From the branch." >/dev/null)
check "the issue from the branch" "yes" "$([ -e "$d/release-notes/ios/pending/77-from-the-branch.md" ] && echo yes)"
check "refuses an unnamed app" "fails" "$( (cd "$d" && ./scripts/note fixed "No app." >/dev/null 2>&1) && echo passes || echo fails)"

echo "images:"
d=$(fixture 2026.1.0)
printf 'GIF89a' >"$tmp/shot.GIF"
(cd "$d" && ./scripts/note both new --image "$tmp/shot.GIF" --alt "Two windows, side by side" "Windows of their own." >/dev/null)
check "the image is copied beside each app's note" "yes yes" \
  "$([ -f "$d/release-notes/mac/pending/windows-of-their-own.gif" ] && echo yes) $([ -f "$d/release-notes/ios/pending/windows-of-their-own.gif" ] && echo yes)"
check "…and named on its image: line" "image: windows-of-their-own.gif Two windows, side by side" \
  "$(sed -n 3p "$d/release-notes/mac/pending/windows-of-their-own.md")"
check "an image needs alt text" fails "$( (cd "$d" && ./scripts/note mac new --image "$tmp/shot.GIF" "No alt." >/dev/null 2>&1) && echo passes || echo fails)"
check "an INTERNAL note can't have one" fails \
  "$( (cd "$d" && ./scripts/note mac internal --image "$tmp/shot.GIF" --alt x "Hidden." >/dev/null 2>&1) && echo passes || echo fails)"
printf 'x' >"$tmp/shot.txt"
check "only .png, .jpg and .gif" fails "$( (cd "$d" && ./scripts/note mac new --image "$tmp/shot.txt" --alt x "Text." >/dev/null 2>&1) && echo passes || echo fails)"
git -C "$d" add -A && git -C "$d" commit -qm image && git -C "$d" push -q
release "$d" apple next allow-empty
check "the Mac's notes show it from the release's tag" yes "$(contains '<li>Windows of their own.<br><img src="https://raw.githubusercontent.com/homegrownsw/hammock/Mac-v2026.1.0-r3/release-notes/mac/v2026.1.0/windows-of-their-own.gif" alt="Two windows, side by side"' "$(cat "$tmp/notes.html")")"
check "TestFlight's text leaves it out" "• Windows of their own." \
  "$(grep -F 'Windows of their own' "$d/apple/iOS/TestFlight/WhatToTest.en-GB.txt" 2>/dev/null)"
check "the image moves into the version's notes" "yes" \
  "$(git -C "$d" cat-file -e HEAD:release-notes/mac/v2026.1.0/windows-of-their-own.gif 2>/dev/null && echo yes)"
calls >/dev/null
(cd "$d" && ./scripts/note mac fixed "Later." >/dev/null && git add -A && git commit -qm later && git push -q)
release "$d" mac 2026.2.0
check "a version's summary shows it under its note" "  ![Two windows, side by side](v2026.1.0/windows-of-their-own.gif)" \
  "$(git -C "$d" show HEAD:release-notes/mac/v2026.1.0.md | grep -F '![')"
calls >/dev/null

echo "note-check:"
d=$(fixture 2026.1.0)
mkdir -p "$d"/internal/daemon "$d"/apple/Sources/HammockKit "$d"/apple/iOS/Hammock "$d"/docs
nc() { (cd "$d" && ./scripts/note-check >/dev/null 2>&1) && echo passes || echo fails; }
echo x >"$d/docs/a.md"
check "docs need no note" passes "$(nc)"
echo x >"$d/internal/daemon/conn_test.go"
check "tests need no note" passes "$(nc)"
echo x >"$d/internal/daemon/conn.go"
check "the daemon needs a Mac note" fails "$(nc)"
(cd "$d" && ./scripts/note mac fixed "Daemon." >/dev/null)
check "…which it then has" passes "$(nc)"
echo x >"$d/apple/Sources/HammockKit/A.swift"
check "HammockKit needs an iOS note too" fails "$(nc)"
(cd "$d" && ./scripts/note ios internal "Kit." >/dev/null)
check "…and passes with both" passes "$(nc)"
rm -rf "$d/release-notes/ios/pending/kit.md"
check "NO_RELEASE_NOTE=1 skips it" passes "$( (cd "$d" && NO_RELEASE_NOTE=1 ./scripts/note-check >/dev/null 2>&1) && echo passes || echo fails)"

echo "dry run:"
d=$(fixture 2026.1.0)
out=$(cd "$d" && HMK_RELEASE_DRYRUN=1 ./scripts/release apple next 2>&1)
check "tags carry the next commit's number" yes "$(contains "Mac-v2026.1.0-r2 and iOS-v2026.1.0-r2" "$out")"
check "INTERNAL stays out of the notes" no "$(contains "Plumbing" "$out")"
check "changes nothing" "1 " "$(count "$d") $(remote_tags "$d")"
check "builds nothing" "" "$(calls)"
printf '100\n' >"$d/scripts/history-commits"
out=$(cd "$d" && HMK_RELEASE_DRYRUN=1 ./scripts/release apple next 2>&1)
check "numbers count the commits before this repo too" yes "$(contains "Mac-v2026.1.0-r102 and iOS-v2026.1.0-r102" "$out")"

echo "versions:"
d=$(fixture 2026.1.0)
dry() { (cd "$d" && HMK_RELEASE_DRYRUN=1 ./scripts/release "$@" 2>&1 | sed -nE 's/^\[dry run\] commit .([^ ]+ v[^ ]+).*/\1/p'); }
check "an unreleased version is released as it is" "release(mac): v2026.1.0" "$(dry mac next)"
mark_released "$d" Mac 2026.1.0
mark_released "$d" iOS 2026.1.0
check "a released Mac version moves to the next patch" "release(mac): v2026.1.1" "$(dry mac next)"
check "iOS next is a patch too" "release(ios): v2026.1.1" "$(dry ios next)"
check "iOS build keeps the version" "release(ios): v2026.1.0" "$(dry ios build)"
check "a joint release is the next N" "release: v2026.2.0" "$(dry apple next)"
check "the Mac can't build the same version" "" "$(dry mac build)"
check "a version that doesn't go up is refused" "" "$(dry mac 2026.0.9)"
check "a released Mac version can't be cut again" "" "$(dry mac 2026.1.0)"
check "a chosen version" "release(ios): v2026.3.0" "$(dry ios 2026.3.0)"
d=$(fixture 2026.4.2 2026.4.0)
mark_released "$d" Mac 2026.4.2
mark_released "$d" iOS 2026.4.0
check "joint: past both apps" "release: v2026.5.0" "$(dry apple next)"
check "joint: a new year starts at 1" "release: v2027.1.0" "$(HMK_RELEASE_YEAR=2027 dry apple next)"
d=$(fixture 0.4.0)
mark_released "$d" Mac 0.4.0
mark_released "$d" iOS 0.4.0
check "joint: from 0.x to this year's first" "release: v2026.1.0" "$(dry apple next)"
check "just version shows each app" "Mac: 0.4.0|iOS: 0.4.0|Android: 0.4.0" "$( (cd "$d" && ./scripts/version) | tr '\n' '|' | sed 's/|$//')"
(cd "$d" && ./scripts/version ios 2026.1.0 >/dev/null)
check "just version sets one" "0.4.0 2026.1.0" "$(sed -nE 's/^HAMMOCK_(MAC|IOS)_VERSION = (.*)/\2/p' "$d/apple/iOS/Config/Version.xcconfig" | tr '\n' ' ' | sed 's/ $//')"

echo "iOS release:"
d=$(fixture 2026.1.0)
release "$d" ios next
check "pushed the release commit and tag" "2 iOS-v2026.1.0-r2" "$(count "$d.remote" main) $(remote_tags "$d")"
wtt=$(cat "$d/apple/iOS/TestFlight/WhatToTest.en-GB.txt")
check "What to Test, New then Fixed" "This build||New|• A new thing.||Fixed|• A <thing> & more works now." "$(printf '%s' "$wtt" | tr '\n' '|')"
check "en-US is the same" "$wtt" "$(cat "$d/apple/iOS/TestFlight/WhatToTest.en-US.txt")"
check "filed the iOS notes" "0 3" "$(ls "$d/release-notes/ios/pending" | wc -l | tr -d ' ') $(ls "$d/release-notes/ios/v2026.1.0" | wc -l | tr -d ' ')"
check "left the Mac's pending" "3" "$(ls "$d/release-notes/mac/pending" | wc -l | tr -d ' ')"
check "built, then uploaded, the iPhone's alone" "ios build 2|ios upload 2|" "$(calls | tr '\n' '|')"
check "a second cut needs notes" fails "$(release "$d" ios build && echo passes || echo fails)"
release "$d" ios build allow-empty
wtt=$(cat "$d/apple/iOS/TestFlight/WhatToTest.en-GB.txt")
check "…or allow-empty, listing the earlier build's" yes "$(contains "Earlier 2026.1 builds" "$wtt")"
check "…as r3, the same version" "iOS-v2026.1.0-r2 iOS-v2026.1.0-r3" "$(remote_tags "$d")"
release "$d" ios next allow-empty
check "a hotfix is the next patch" "iOS-v2026.1.0-r2 iOS-v2026.1.0-r3 iOS-v2026.1.1-r4" "$(remote_tags "$d")"
check "…set in the tagged commit" "2026.1.1" "$(ver "$d" IOS iOS-v2026.1.1-r4)"
check "…leaving the Mac's alone" "2026.1.0" "$(ver "$d" MAC iOS-v2026.1.1-r4)"
check "…with 2026.1.0's summary" "yes" "$([ -e "$d/release-notes/ios/v2026.1.0.md" ] && echo yes)"
calls >/dev/null

echo "a failed iPhone build takes it all back:"
d=$(fixture 2026.1.0)
check "fails" fails "$( (cd "$d" && FAKE_IOS_BUILD_FAIL=1 ./scripts/release ios next >/dev/null 2>&1) && echo passes || echo fails)"
check "…publishing nothing" "1 " "$(count "$d.remote" main) $(remote_tags "$d")"
check "…back where it started, the notes still pending" "1 3" "$(count "$d") $(ls "$d/release-notes/ios/pending" | wc -l | tr -d ' ')"
check "…and the build discarded" "ios build 2|ios discard 2|" "$(calls | tr '\n' '|')"

echo "a failed TestFlight upload keeps the release:"
d=$(fixture 2026.1.0)
out=$(cd "$d" && FAKE_IOS_UPLOAD_FAIL=1 ./scripts/release ios next 2>&1) || true
check "pushed anyway" "iOS-v2026.1.0-r2" "$(remote_tags "$d")"
check "and says how to retry" yes "$(contains "scripts/ios-testflight upload 2" "$out")"
calls >/dev/null

echo "Mac release:"
d=$(fixture 2026.1.0)
deploys >/dev/null
release "$d" mac next
check "built, then uploaded, release 2" "build 2|upload 2|" "$(calls | tr '\n' '|')"
check "pushed the commit and tag" "2 Mac-v2026.1.0-r2" "$(count "$d.remote" main) $(remote_tags "$d")"
check "deployed the website from the release commit" "--ref $(git -C "$d.remote" rev-parse main)" "$(deploys)"
html=$(cat "$tmp/notes.html")
check "the notes as HTML, escaped" yes "$(contains "<li>A &lt;thing&gt; &amp; more works now.</li>" "$html")"
check "in sections, New first" "<h4>New</h4>|<ul>|<li>A new thing.</li>|</ul>|<h4>Fixed</h4>|<ul>|<li>A &lt;thing&gt; &amp; more works now.</li>|</ul>" "$(printf '%s' "$html" | tr '\n' '|')"
(cd "$d" && ./scripts/note mac fixed "Patched." >/dev/null && git add -A && git commit -qm note && git push -q origin main)
release "$d" mac next
check "the next Mac release is a patch" "Mac-v2026.1.0-r2 Mac-v2026.1.1-r4" "$(remote_tags "$d")"
check "…set in the tagged commit" "2026.1.1" "$(ver "$d" MAC Mac-v2026.1.1-r4)"
check "…leaving the iPhone's alone" "2026.1.0" "$(ver "$d" IOS Mac-v2026.1.1-r4)"
html=$(cat "$tmp/notes.html")
check "…its notes, then the family's earlier ones" "<h4>Fixed</h4>|<ul>|<li>Patched.</li>|</ul>|<h3>Earlier in 2026.1</h3>|<h4>New</h4>|<ul>|<li>A new thing.</li>|</ul>|<h4>Fixed</h4>|<ul>|<li>A &lt;thing&gt; &amp; more works now.</li>|</ul>" "$(printf '%s' "$html" | tr '\n' '|')"
check "…and 2026.1.0's summary" "# Mac 2026.1.0||## New||- A new thing.||## Fixed||- A <thing> & more works now.||## Internal||- Plumbing." "$(tr '\n' '|' <"$d/release-notes/mac/v2026.1.0.md" | sed 's/|$//')"
calls >/dev/null

echo "a failed Mac build takes it all back:"
d=$(fixture 2026.1.0)
deploys >/dev/null
mark_released "$d" Mac 2026.1.0
check "fails" fails "$( (cd "$d" && FAKE_BUILD_FAIL=1 ./scripts/release mac next >/dev/null 2>&1) && echo passes || echo fails)"
check "…publishing nothing" "1 Mac-v2026.1.0-r1" "$(count "$d.remote" main) $(remote_tags "$d")"
check "…back where it started, with no new tag" "1 Mac-v2026.1.0-r1" "$(count "$d") $(git -C "$d" tag -l)"
check "…and its version" "2026.1.0" "$(ver "$d" MAC)"
check "…the notes still pending" "3" "$(ls "$d/release-notes/mac/pending" | wc -l | tr -d ' ')"
check "…and the build discarded" "build 2|discard 2|" "$(calls | tr '\n' '|')"
check "…and the website left alone" "" "$(deploys)"

echo "a failed website deploy keeps the release:"
d=$(fixture 2026.1.0)
out=$(cd "$d" && FAKE_SITE_FAIL=1 ./scripts/release mac next 2>&1) || true
check "pushed anyway" "Mac-v2026.1.0-r2" "$(remote_tags "$d")"
check "and says how to retry" yes "$(contains "scripts/site-deploy --ref" "$out")"
calls >/dev/null
deploys >/dev/null

echo "a failed upload keeps the release:"
d=$(fixture 2026.1.0)
out=$(cd "$d" && FAKE_UPLOAD_FAIL=1 ./scripts/release mac next 2>&1) || true
check "pushed anyway" "Mac-v2026.1.0-r2" "$(remote_tags "$d")"
check "and says how to retry" yes "$(contains "scripts/mac-update upload 2" "$out")"
calls >/dev/null

echo "rejected push:"
d=$(fixture 2026.1.0)
other="$tmp/other-$RANDOM"
git clone -q "$d.remote" "$other"
git -C "$other" -c user.email=t@example.com -c user.name=T commit -q --allow-empty -m "someone else"
git -C "$other" push -q origin main
# The preflight would refuse a checkout behind origin/main, so move main after it: the build is the moment.
cat >"$tmp/mac-update-push" <<EOF
#!/usr/bin/env bash
echo "\$1 \$2" >>"$tmp/mac-update.log"
if [ "\$1" = build ]; then git -C "$other" -c user.email=t@example.com -c user.name=T commit -q --allow-empty -m race; git -C "$other" push -q origin main; fi
EOF
chmod +x "$tmp/mac-update-push"
git -C "$d" pull -q --rebase origin main
start=$(git -C "$d" rev-parse HEAD)
check "fails" fails "$( (cd "$d" && HMK_RELEASE_MAC_UPDATE="$tmp/mac-update-push" ./scripts/release apple next >/dev/null 2>&1) && echo passes || echo fails)"
check "…no tags published or kept" "|" "$(remote_tags "$d")|$(git -C "$d" tag -l)"
check "…back where it started" "$start" "$(git -C "$d" rev-parse HEAD)"
check "…both builds discarded, never uploaded" "build 3|ios build 3|discard 3|ios discard 3|" "$(calls | tr '\n' '|')"

echo "a commit on top of the release while it builds:"
d=$(fixture 2026.1.0)
cat >"$tmp/mac-update-sneak" <<EOF
#!/usr/bin/env bash
echo "\$1 \$2" >>"$tmp/mac-update.log"
if [ "\$1" = build ]; then git -C "$d" -c user.email=t@example.com -c user.name=T commit -q --allow-empty -m sneaked; fi
EOF
chmod +x "$tmp/mac-update-sneak"
check "fails" fails "$( (cd "$d" && HMK_RELEASE_MAC_UPDATE="$tmp/mac-update-sneak" ./scripts/release mac next >/dev/null 2>&1) && echo passes || echo fails)"
check "…publishing nothing" "1 " "$(count "$d.remote" main) $(remote_tags "$d")"
check "…keeping the other commit" "sneaked" "$(git -C "$d" log -1 --format=%s)"
calls >/dev/null

echo "joint release:"
d=$(fixture 0.4.0)
mark_released "$d" Mac 0.4.0
mark_released "$d" iOS 0.4.0
mkdir -p "$d/release-notes/mac/v0.4.0" && printf 'tag: NEW\ndate: 2026-10-01\nOld.\n' >"$d/release-notes/mac/v0.4.0/old.md"
(cd "$d" && git add -A && git commit -qm old && git push -q origin main)
release "$d" apple next
check "both tagged in one commit" "3 Mac-v0.4.0-r1 Mac-v2026.1.0-r3 iOS-v0.4.0-r1 iOS-v2026.1.0-r3" "$(count "$d.remote" main) $(remote_tags "$d")"
check "both versions set in it" "2026.1.0 2026.1.0" "$(ver "$d" MAC Mac-v2026.1.0-r3) $(ver "$d" IOS iOS-v2026.1.0-r3)"
check "the old version's summary, only where it had notes" "yes no" "$([ -e "$d/release-notes/mac/v0.4.0.md" ] && echo yes || echo no) $([ -e "$d/release-notes/ios/v0.4.0.md" ] && echo yes || echo no)"
html=$(cat "$tmp/notes.html")
check "the Mac's notes leave 0.4.0's out" no "$(contains "Old." "$html")"
calls >/dev/null

echo "editing the notes:"
d=$(fixture 2026.1.0)
(
  cd "$d"
  . scripts/lib/release-notes.sh
  notes_doc "$d" "mac ios" "Test" >"$tmp/doc.md"
  apply_notes_doc "$tmp/doc.md" "$d" "mac ios"
)
check "the document reads back to the same notes" "" "$(git -C "$d" status --porcelain)"
# Order: a NEW note with a picture leads its section; moving notes in the document keeps them where they were put.
od=$(fixture 2026.1.0)
printf 'tag: NEW\ndate: 2026-11-01\nimage: z.gif A picture\nPictured.\n' >"$od/release-notes/mac/pending/z-pictured.md"
printf 'tag: NEW\ndate: 2026-11-01\nAnother.\n' >"$od/release-notes/mac/pending/another.md"
order_of() { (. "$od/scripts/lib/release-notes.sh"; render_dir "$od/release-notes/mac/pending" | cut -f1 | tr '\n' '|'); }
check "a picture leads New, then file names" "[NEW] Pictured.|[NEW] Another.|[NEW] A new thing.|[FIXED] A <thing> & more works now.|" "$(order_of)"
(
  cd "$od"
  . scripts/lib/release-notes.sh
  notes_doc "$od" mac "Test" >"$tmp/doc.md"
  apply_notes_doc "$tmp/doc.md" "$od" mac
)
check "…and reading it back unmoved adds no order lines" "" "$(grep -l '^order:' "$od"/release-notes/mac/pending/*.md)"
# Moves "Another." to the top: its === line and the lines after it, to before the first note.
(
  cd "$od"
  . scripts/lib/release-notes.sh
  notes_doc "$od" mac "Test" >"$tmp/doc.md"
  awk '/^=== /{ inmove = ($2 == "mac/another.md") } inmove { moved = moved $0 "\n"; next } { rest = rest $0 "\n" }
    END { n = index(rest, "\n=== "); printf "%s\n%s%s", substr(rest, 1, n), moved, substr(rest, n + 1) }' "$tmp/doc.md" >"$tmp/doc2.md"
  apply_notes_doc "$tmp/doc2.md" "$od" mac
)
check "a note moved up in the document is shown there" "[NEW] Another.|[NEW] Pictured.|[NEW] A new thing.|[FIXED] A <thing> & more works now.|" "$(order_of)"
check "…from an order line after its date" "order: 1" "$(sed -n 3p "$od/release-notes/mac/pending/another.md")"
check "…which stays out of its text" "Another." "$(. "$od/scripts/lib/release-notes.sh"; note_body "$od/release-notes/mac/pending/another.md")"
check "…and out of the document" "" "$( (. "$od/scripts/lib/release-notes.sh"; notes_doc "$od" mac "Test") | grep '^order:')"
check "…which reads back the same" "[NEW] Another.|[NEW] Pictured.|[NEW] A new thing.|[FIXED] A <thing> & more works now.|" "$(
  (cd "$od" && . scripts/lib/release-notes.sh && notes_doc "$od" mac "Test" >"$tmp/doc.md" && apply_notes_doc "$tmp/doc.md" "$od" mac)
  order_of)"
check "a version's summary keeps it" "- Another.|- Pictured.|- A new thing.|" \
  "$(. "$od/scripts/lib/release-notes.sh"; render_consolidated_lines "$od/release-notes/mac/pending" | grep '^- ' | head -3 | tr '\n' '|')"
# The stand-in editor: rewrites the FIXED note, merges the INTERNAL one away, and adds one with no date.
cat >"$tmp/edit-notes" <<'EOF'
#!/usr/bin/env bash
sed -i.bak -e 's/^A <thing> & more works now\.$/Things work better now./' -e '/^=== mac\/plumbing.md$/,/^Plumbing\.$/d' "$1"
printf '\n=== mac/added\ntag: fixed\n\nAn added note.\n' >>"$1"
EOF
chmod +x "$tmp/edit-notes"
(cd "$d" && HMK_RELEASE_NOTES_EDITOR="$tmp/edit-notes" ./scripts/release mac next >/dev/null 2>&1)
check "an edited note is released as edited" "Things work better now." "$(git -C "$d" show HEAD:release-notes/mac/v2026.1.0/1-a-thing.md | tail -n1)"
check "a note deleted from it isn't released" "no" "$(git -C "$d" cat-file -e HEAD:release-notes/mac/v2026.1.0/plumbing.md 2>/dev/null && echo yes || echo no)"
check "an added note gets .md, its tag and today's date" "tag: FIXED date: $(date +%F) An added note." "$(git -C "$d" show HEAD:release-notes/mac/v2026.1.0/added.md | tr '\n' ' ' | sed 's/ $//')"
check "…and is in the update's notes" yes "$(contains "An added note." "$(cat "$tmp/notes.html")")"
check "the edits are in the release commit, pushed" "clean 2" "$([ -z "$(git -C "$d" status --porcelain)" ] && echo clean) $(count "$d.remote" main)"
check "iOS's notes are untouched" "A <thing> & more works now." "$(tail -n1 "$d/release-notes/ios/pending/1-a-thing.md")"
calls >/dev/null
d=$(fixture 2026.1.0)
(cd "$d" && FAKE_BUILD_FAIL=1 HMK_RELEASE_NOTES_EDITOR="$tmp/edit-notes" ./scripts/release mac next >/dev/null 2>&1) || true
check "a release taken back leaves the edits, uncommitted" "1 Things work better now. no yes" \
  "$(count "$d") $(tail -n1 "$d/release-notes/mac/pending/1-a-thing.md") $([ -e "$d/release-notes/mac/pending/plumbing.md" ] && echo yes || echo no) $([ -e "$d/release-notes/mac/pending/added.md" ] && echo yes || echo no)"
calls >/dev/null
d=$(fixture 2026.1.0)
printf '#!/usr/bin/env bash\nsed -i.bak "s/^tag: NEW$/tag: NOPE/" "$1"\n' >"$tmp/bad-edit"
chmod +x "$tmp/bad-edit"
check "a note with a wrong tag stops the release" fails "$( (cd "$d" && HMK_RELEASE_NOTES_EDITOR="$tmp/bad-edit" ./scripts/release mac next >/dev/null 2>&1) && echo passes || echo fails)"
check "…changing nothing" "1 clean" "$(count "$d") $([ -z "$(git -C "$d" status --porcelain)" ] && echo clean)"
printf '#!/usr/bin/env bash\nprintf "\\n=== ios/sneaky\\ntag: NEW\\nNot this release.\\n" >>"$1"\n' >"$tmp/bad-edit"
check "a note for an app not being released is refused" fails "$( (cd "$d" && HMK_RELEASE_NOTES_EDITOR="$tmp/bad-edit" ./scripts/release mac next >/dev/null 2>&1) && echo passes || echo fails)"
calls >/dev/null

echo "an agent's release, the notes read in a pane:"
# The stand-in hmk: `hmk edit FILE` runs $FAKE_PANE_EDIT on it, as if the person edited it in the pane and
# closed it, which `hmk edit --read` then finds.
mkdir -p "$tmp/bin"
cat >"$tmp/bin/hmk" <<'EOF'
#!/usr/bin/env bash
if [ "$1 $2" = "edit --read" ]; then exit 1; fi
if [ "$1" = edit ]; then ${FAKE_PANE_EDIT:-true} "$2"; echo pn_fake; exit 0; fi
exit 1
EOF
chmod +x "$tmp/bin/hmk"
agent() { (cd "$d" && PATH="$tmp/bin:$PATH" HMK_PANE_ID=pn_agent ./scripts/release "$@" </dev/null 2>&1); }
d=$(fixture 2026.1.0)
out=$(FAKE_PANE_EDIT="$tmp/edit-notes" agent mac next) && st=0 || st=$?
check "the first run stops, exit 3, releasing nothing" "3 1 " "$st $(count "$d") $(remote_tags "$d")"
check "…printing the notes as edited" yes "$(contains "Things work better now." "$out")"
check "…and how to release them" yes "$(contains "scripts/release mac next approved" "$out")"
check "…the edits left in the tree" "Things work better now." "$(tail -n1 "$d/release-notes/mac/pending/1-a-thing.md")"
calls >/dev/null
check "approved, after the notes change, is refused" fails "$(
  printf 'tag: NEW\ndate: 2026-11-01\nSlipped in.\n' >"$d/release-notes/mac/pending/sneaky.md"
  agent mac next approved >/dev/null && echo passes || echo fails)"
rm "$d/release-notes/mac/pending/sneaky.md"
check "approved for another version is refused" fails "$(agent mac 2026.2.0 approved >/dev/null && echo passes || echo fails)"
agent mac next approved >/dev/null || true
check "approved releases the notes the person read" "2 Things work better now. no" \
  "$(count "$d.remote" main) $(git -C "$d" show HEAD:release-notes/mac/v2026.1.0/1-a-thing.md | tail -n1) $(git -C "$d" cat-file -e HEAD:release-notes/mac/v2026.1.0/plumbing.md 2>/dev/null && echo yes || echo no)"
check "…leaving a clean tree" "" "$(git -C "$d" status --porcelain)"
calls >/dev/null
d=$(fixture 2026.1.0)
check "approved with no reading first is refused" fails "$(agent mac next approved >/dev/null && echo passes || echo fails)"
check "a run outside a pane and a terminal (CI) just releases" "2" "$( (cd "$d" && ./scripts/release mac next </dev/null >/dev/null 2>&1); count "$d.remote" main)"
calls >/dev/null

echo "android:"
d=$(fixture 2026.1.0 2026.1.0 2026.5.0)
release "$d" android next
check "tagged, at its own version (in the file, not yet released)" "Android-v2026.5.0-r2" "$(remote_tags "$d")"
check "built, then published after the push" "android build 2
android upload 2" "$(calls)"
check "the notes it publishes leave INTERNAL out" "no yes" \
  "$(contains Plumbing "$(cat "$tmp/android-notes.html")") $(contains 'A new thing.' "$(cat "$tmp/android-notes.html")")"
check "its update feed, in the release commit" \
  '2026.5.0 2 https://github.com/homegrownsw/hammock/releases/download/Android-v2026.5.0-r2/Hammock-2026.5.0.apk' \
  "$(git -C "$d" show HEAD:marketing/android.json | jq -r '"\(.version) \(.build) \(.apk)"')"
check "the Mac's and iPhone's versions and notes are left alone" "2026.1.0 2026.1.0 3 3" \
  "$(ver "$d" MAC) $(ver "$d" IOS) $(ls "$d/release-notes/mac/pending" | wc -l | tr -d ' ') $(ls "$d/release-notes/ios/pending" | wc -l | tr -d ' ')"
check "the Android notes move under the version" "3" "$(ls "$d/release-notes/android/v2026.5.0" | wc -l | tr -d ' ')"
check "a version released already isn't again" fails "$(release "$d" android 2026.5.0 allow-empty && echo passes || echo fails)"
release "$d" android next allow-empty
check "the next is a patch" "Android-v2026.5.1-r3" "$(git -C "$d" describe --tags --abbrev=0 HEAD)"
calls >/dev/null
d=$(fixture 2026.1.0 2026.1.0 2026.5.0)
check "a build that fails" fails "$(FAKE_ANDROID_BUILD_FAIL=1 release "$d" android next && echo passes || echo fails)"
check "…takes the release back" "1 " "$(count "$d") $(git -C "$d" tag -l | tr '\n' ' ' | sed 's/ $//')"
check "…and discards what it built" "android build 2
android discard 2" "$(calls)"

echo "preflight:"
d=$(fixture 2026.1.0)
echo dirty >"$d/x"
check "a dirty tree is refused" fails "$(release "$d" ios next && echo passes || echo fails)"
rm "$d/x"
git -C "$d" commit -q --allow-empty -m unpushed
check "unpushed commits are refused" fails "$(release "$d" ios next && echo passes || echo fails)"

echo "the committed notes:"
bad=""
for f in "$REPO"/release-notes/*/pending/*.md "$REPO"/release-notes/*/v*/*.md; do
  [ -f "$f" ] || continue
  head -n1 "$f" | grep -Eq '^tag: (NEW|FIXED|INTERNAL)$' || bad+="${f#"$REPO"/} "
  sed -n 2p "$f" | grep -Eq '^date: [0-9]{4}-[0-9]{2}-[0-9]{2}$' || bad+="${f#"$REPO"/} "
  img=$(sed -nE 's/^image:[[:space:]]*([^[:space:]]+).*/\1/p' "$f")
  [ -z "$img" ] || [ -f "$(dirname "$f")/$img" ] || bad+="${f#"$REPO"/} "
done
check "every note is well formed" "" "$bad"

echo
echo "$pass passed, $fail failed"
[ "$fail" -eq 0 ]

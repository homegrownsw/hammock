<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- "Hammock Browser Helper (Plugin)": plugins are code from elsewhere.
       As Chromium's helper-plugin-entitlements.plist. The host and the
       other helpers get no entitlements. -->

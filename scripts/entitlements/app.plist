<plist version="1.0">
<dict>
  <!-- The agent view's dictation button: the hardened runtime refuses the microphone
       without it, silently. Signs Hammock.app itself (sign-mac-app.sh, and the
       HammockMacApp target through HammockMac.xcconfig). -->

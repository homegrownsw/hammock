<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The agent view's dictation button: the hardened runtime refuses the microphone
       without it, silently. Signs Hammock.app itself (sign-mac-app.sh, and the
       HammockMacApp target through HammockMac.xcconfig). -->
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- Scheduled tasks' calendar triggers (CalendarFeed.swift): reading your calendars. -->
  <key>com.apple.security.personal-information.calendars</key><true/>
  <!-- Automations' Wi-Fi triggers and Only If (MacWatcher.swift): macOS gives the Wi-Fi
       network's name only to apps with Location Services. -->
  <key>com.apple.security.personal-information.location</key><true/>
</dict>
</plist>

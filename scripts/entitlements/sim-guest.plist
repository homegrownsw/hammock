<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- hmk-sim-guest runs inside a simulator (`xcrun simctl spawn`), which starts it with DYLD_ROOT_PATH and the
       simulator runtime's shared cache. The hardened runtime drops DYLD_* variables and refuses libraries it
       can't validate, so without these it dies at launch ("DYLD_ROOT_PATH not set") and foldables don't fold. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>

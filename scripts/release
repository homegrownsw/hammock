#!/usr/bin/env bash
# Cuts a release (release-notes/README.md): of the Mac app (a Sparkle update), the iOS app (a TestFlight
# build), or both at once. `just release-mac`, `just release-ios` and `just release-apple` run it.
#
#   scripts/release <mac|ios|apple>                     prompts with gum
#   scripts/release <mac|ios|apple> next [allow-empty]  the app's next version (below)
#   scripts/release ios build [allow-empty]             another TestFlight build of the iPhone's version
#   scripts/release <mac|ios|apple> <x.y.z> [...]       a version of your choosing
#
# Each app has its own version, YYYY.N.P (apple/iOS/Config/Version.xcconfig): the year, its Nth joint release,
# and a patch. A joint release (apple) is both apps at the next YYYY.N.0; the Mac ships patches in between
# (2026.1.1, 2026.1.2…), each its own version, while the iPhone gets more TestFlight builds of its YYYY.N.0
# (a new iOS version means another App Review), or a patch for a hotfix. `next` is, for the Mac or iOS, the
# next patch, and for both the next joint release; an app whose version in the file hasn't been released yet
# (set ahead with `just version`) is released at that version instead. The release commit itself sets the
# version, since a build is made from exactly the tagged commit and checks its version against the tag.
#
# For each app it freezes the pending notes into the release, files them under the version, then commits,
# tags and pushes:
#
#   mac    tag Mac-v<x.y.z>-r<n>. Before anything is pushed it builds the tagged commit with its update feed,
#          notarizes it, and makes the appcast with the notes in it (scripts/mac-update build); a failure
#          there takes the release commit and tag back. After the push it publishes the update as a GitHub
#          Release (scripts/mac-update upload), where Sparkle finds it.
#   ios    apple/iOS/TestFlight/WhatToTest.<locale>.txt, tag iOS-v<x.y.z>-r<n>. Before anything is pushed it
#          archives the tagged commit and exports it signed for App Store Connect (scripts/ios-testflight
#          build); a failure there takes the release back. After the push it uploads the build to TestFlight
#          with What to Test (scripts/ios-testflight upload).
#   apple  both, in one release commit carrying both tags.
#
# An app moving on from a version gets that version's summary, release-notes/<app>/v<old>.md, in the commit.
#
# n in r<n> is the release commit's number on main (scripts/commit-number), which is also the Mac build's
# CFBundleVersion, the Mac's and the iPhone's: Mac-v2026.1.0-r615 is build 615, and an iOS release cut
# alongside it is r615 too. Each cut makes a commit, so no two releases share a number.
#
# With arguments, every confirmation counts as yes and the edge cases fail instead of asking. Runs from a
# clean checkout exactly level with origin/main (require_level_with_origin_main).
#
# HMK_RELEASE_DRYRUN=1 prints the plan (the notes each release would carry, the notes it would move, the
# tags, the versions) and changes nothing, skipping the preflight so it runs anywhere.
# HMK_RELEASE_MAC_UPDATE and HMK_RELEASE_IOS_TESTFLIGHT name stand-ins for scripts/mac-update and
# scripts/ios-testflight (the tests use them); HMK_RELEASE_YEAR the year.
set -euo pipefail
shopt -s nullglob

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DRYRUN="${HMK_RELEASE_DRYRUN:-}"
MAC_UPDATE="${HMK_RELEASE_MAC_UPDATE:-$ROOT/scripts/mac-update}"
IOS_TESTFLIGHT="${HMK_RELEASE_IOS_TESTFLIGHT:-$ROOT/scripts/ios-testflight}"

# shellcheck source=lib/release-notes.sh
. "$ROOT/scripts/lib/release-notes.sh"

# ---- the apps ----------------------------------------------------------------------------------------------
TARGET="${1:-}"
case "$TARGET" in
  mac) PLATFORMS="mac" ;;
  ios) PLATFORMS="ios" ;;
  apple) PLATFORMS="mac ios" ;;
  *) echo "usage: scripts/release <mac|ios|apple> [next | build | <x.y.z>] [allow-empty]" >&2; exit 2 ;;
esac
shift
has() { [[ " $PLATFORMS " == *" $1 "* ]]; }

# iOS: TestFlight/WhatToTest.<locale>.txt next to the project, one per TestFlight language (the upload sends
# each), at most 4000 characters. Sparkle takes HTML, with no limit to speak of.
IOS_NOTES_DIR="$ROOT/apple/iOS/TestFlight"
IOS_NOTES_LOCALES="en-GB en-US"

usage() {
  cat >&2 <<EOF
usage: scripts/release $TARGET [next | build | <x.y.z>] [allow-empty]

  (no arguments)   prompts with gum
  next             the next version: a patch for the Mac or iOS (2026.1.0 → 2026.1.1),
                   the next joint release for both (→ 2026.2.0, or 2027.1.0 in a new year)
  build            iOS only: another TestFlight build of the iPhone's version
  <x.y.z>          this version, higher than the app's last
  allow-empty      cut a release even with no new notes for people to read
EOF
  exit 2
}

# ---- arguments ---------------------------------------------------------------------------------------------
NONINTERACTIVE=0
MODE=""
ASKED_VER=""
ALLOW_EMPTY=0
if [ "$#" -gt 0 ]; then
  NONINTERACTIVE=1
  for a in "$@"; do
    case "$a" in
      next) MODE=next ;;
      build) MODE=build ;;
      allow-empty) ALLOW_EMPTY=1 ;;
      [0-9]*) MODE=version; ASKED_VER="$a" ;;
      *) echo "Unknown argument '$a'." >&2; usage ;;
    esac
  done
  [ -n "$MODE" ] || { echo "Say 'next'$([ "$TARGET" = ios ] && echo ", 'build'") or a version." >&2; usage; }
  if [ "$MODE" = build ] && [ "$TARGET" != ios ]; then
    echo "'build' is for iOS: every Mac release, and every joint one, is a new version." >&2; usage
  fi
fi

if [ "$NONINTERACTIVE" != 1 ] && [ -z "$DRYRUN" ] && ! command -v gum >/dev/null 2>&1; then
  echo "Prompting needs gum: brew install gum. Or pass the arguments, e.g. just release-$TARGET next" >&2
  exit 1
fi

# ---- preflight ---------------------------------------------------------------------------------------------
if [ -z "$DRYRUN" ]; then
  require_level_with_origin_main "$ROOT"
else
  echo "[dry run] skipping the preflight (branch, clean tree, level with origin/main)"
  git -C "$ROOT" fetch --tags --quiet 2>/dev/null || true
fi

# ---- credentials, up front ---------------------------------------------------------------------------------
# Everything 1Password holds for this release is asked for now, before anything is built, rather than as each
# step reaches it (an unanswered prompt an hour in times out and takes the release back). Only with the real
# scripts/mac-update and scripts/ios-testflight; the tests' stand-ins need nothing.
if [ -z "$DRYRUN" ]; then
  # A locked screen, or an agent's sandbox hiding the keychain, fails here in seconds rather than at
  # notarizing or on an unanswered 1Password prompt after the build (scripts/preflight).
  if { has mac && [ "$MAC_UPDATE" = "$ROOT/scripts/mac-update" ]; } ||
    { has ios && [ "$IOS_TESTFLIGHT" = "$ROOT/scripts/ios-testflight" ]; }; then
    "$ROOT/scripts/preflight" screen
  fi
  if has mac && [ "$MAC_UPDATE" = "$ROOT/scripts/mac-update" ]; then "$ROOT/scripts/preflight" notary; fi
  # iOS: the App Store Connect API key, for the build and the upload. The release reruns itself under
  # appstore-fastlane --exec, which resolves it once and keeps it (in 0600 temporary files) until it ends.
  if has ios && [ "$IOS_TESTFLIGHT" = "$ROOT/scripts/ios-testflight" ] && [ -z "${ASC_KEY_P8_PATH:-}" ]; then
    echo "1Password: the App Store Connect API key, for the iPhone's build and upload"
    exec "$ROOT/marketing/scripts/appstore-fastlane" --exec "$ROOT/scripts/release" "$TARGET" "$@"
  fi
  # Mac: notarization's Apple ID and app-specific password, unless there's a notarytool profile, which needs
  # nobody (just share).
  if has mac && [ "$MAC_UPDATE" = "$ROOT/scripts/mac-update" ] && [ -z "${APP_PASSWORD:-}" ] &&
    ! xcrun notarytool history --keychain-profile "${NOTARY_PROFILE:-fika-notary}" >/dev/null 2>&1; then
    if [ -z "${HMK_SHARE_OP_ITEM:-}" ] || [ -z "${HMK_SHARE_OP_ACCOUNT:-}" ]; then
      echo "Notarizing needs the notarytool profile, or HMK_SHARE_OP_ITEM and HMK_SHARE_OP_ACCOUNT (.release.env)." >&2
      exit 1
    fi
    echo "1Password: notarization's Apple ID and password"
    export OP_BIOMETRIC_UNLOCK_ENABLED=true
    APPLE_ID="$(op read "$HMK_SHARE_OP_ITEM/username" --account "$HMK_SHARE_OP_ACCOUNT")"
    APP_PASSWORD="$(op read "$HMK_SHARE_OP_ITEM/password" --account "$HMK_SHARE_OP_ACCOUNT")"
    export APPLE_ID APP_PASSWORD
  fi
fi

# ---- the versions and number -------------------------------------------------------------------------------
# Per app, in variables named after it (CUR_mac, VER_ios, TAG_mac, THIS_ios, …), since macOS's bash has no maps.
set_var() { printf -v "$1_$2" '%s' "$3"; }
get_var() { local n="$1_$2"; printf '%s' "${!n}"; }

for p in $PLATFORMS_ALL; do
  cur=$(read_version "$ROOT" "$p")
  version_ok "$cur" ||
    { echo "$(version_file "$ROOT") sets $(version_key "$p") to '$cur'; it should be x.y.z." >&2; exit 1; }
  set_var CUR "$p" "$cur"
done
# The release commit is the next one on main.
N=$(($("$ROOT/scripts/commit-number" "$ROOT") + 1))

# An app's next version: its version in the file if that hasn't been released yet, else the next patch.
next_for() { # next_for <mac|ios>
  local cur
  cur=$(get_var CUR "$1")
  if is_released "$ROOT" "$1" "$cur"; then next_patch "$cur"; else echo "$cur"; fi
}
# Both apps' next joint release: the version both are set to, if neither has released it, else the next one.
next_joint_for() {
  if [ "$(get_var CUR mac)" = "$(get_var CUR ios)" ] && [ "$(get_var CUR mac | sed -E "s/.*\.//")" = 0 ] &&
    ! is_released "$ROOT" mac "$(get_var CUR mac)" && ! is_released "$ROOT" ios "$(get_var CUR ios)"; then
    get_var CUR mac
  else
    next_joint "$(get_var CUR mac)" "$(get_var CUR ios)"
  fi
}

if [ "$NONINTERACTIVE" != 1 ]; then
  if [ -n "$DRYRUN" ]; then
    MODE=next
  else
    case "$TARGET" in
      mac) MODE=next ;;
      apple)
        MODE=version
        ASKED_VER=$(gum input --header "Both apps' version (a joint release)" --value "$(next_joint_for)") ;;
      ios)
        if is_released "$ROOT" ios "$(get_var CUR ios)"; then
          build="Another TestFlight build of $(get_var CUR ios)"
          choice=$(gum choose --header "This iOS release" "$build" "A new version, $(next_for ios) (App Review again)")
          if [ "$choice" = "$build" ]; then MODE=build; else MODE=next; fi
        else
          MODE=next
        fi ;;
    esac
  fi
fi

for p in $PLATFORMS; do
  cur=$(get_var CUR "$p")
  case "$MODE" in
    build) ver="$cur" ;;
    version) ver="$ASKED_VER" ;;
    next) if [ "$TARGET" = apple ]; then ver=$(next_joint_for); else ver=$(next_for "$p"); fi ;;
  esac
  version_ok "$ver" || { echo "'$ver' isn't a version like 2026.1.0." >&2; exit 1; }
  if [ "$ver" = "$cur" ]; then
    if [ "$p" = mac ] && is_released "$ROOT" mac "$cur"; then
      echo "The Mac has a release of ${cur} already; each Mac release is a new version (next: $(next_for mac))." >&2
      exit 1
    fi
  elif ! version_gt "$ver" "$cur"; then
    echo "The $(label "$p") version must go up: ${ver} isn't higher than ${cur}." >&2
    exit 1
  fi
  set_var VER "$p" "$ver"
done

# ---- each app's tag and notes ------------------------------------------------------------------------------
# The notes of a version's family (2026.1.*), newest first: the earlier releases this one comes after.
render_family() { # render_family <mac|ios> <family>
  local d r lines=""
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    r=$(render_dir "$d")
    if [ -n "$r" ]; then lines+="$r"$'\n'; fi
  done < <(family_dirs "$ROOT" "$1" "$2")
  new_first "$lines"
}

for p in $PLATFORMS; do
  L=$(label "$p")
  ver=$(get_var VER "$p")
  tag="${L}-v${ver}-r${N}"
  if git -C "$ROOT" rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
    echo "$tag already exists: is HEAD a release commit that was never pushed? (git reset --hard origin/main)" >&2
    exit 1
  fi
  set_var TAG "$p" "$tag"
  this=$(render_dir "$ROOT/release-notes/$p/pending")
  prev=$(render_family "$p" "$(version_family "$ver")")
  set_var THIS "$p" "$this"
  set_var PREV "$p" "$prev"

  if [ -z "$this" ]; then
    if [ "$NONINTERACTIVE" = 1 ]; then
      if [ "$ALLOW_EMPTY" != 1 ]; then
        echo "No new notes for people to read in this $L release." >&2
        echo "Add some with 'just note …', or add 'allow-empty' to cut a maintenance release." >&2
        exit 1
      fi
    elif [ -z "$DRYRUN" ]; then
      gum confirm "No new notes for people to read in this $L release. Cut a maintenance release anyway?" ||
        { echo "Stopped."; exit 1; }
    fi
  fi
done

# iOS: TestFlight's What to Test, as plain text: this build's notes, then the earlier builds' of the version's
# family, each under New and Fixed headings.
ios_notes() {
  local this prev
  this=$(get_var THIS ios)
  prev=$(get_var PREV ios)
  fit_to_limit 4000 "$(
    printf 'This build\n\n'
    if [ -n "$this" ]; then printf '%s\n' "$(lines_to_text "$this")"; else printf 'Behind-the-scenes improvements.\n'; fi
    if [ -n "$prev" ]; then printf '\nEarlier %s builds\n\n%s\n' "$(version_family "$(get_var VER ios)")" "$(lines_to_text "$prev")"; fi
  )"
}
# Mac: the same, as HTML for Sparkle's update window (embedded in the appcast by scripts/mac-update, and the
# GitHub Release's notes). Sparkle shows only the newest release's notes, so someone skipping patches still
# sees what the ones they skipped brought.
mac_notes_html() {
  local this prev
  this=$(get_var THIS mac)
  prev=$(get_var PREV mac)
  if [ -n "$this" ]; then lines_to_html "$this"; else echo "<p>Behind-the-scenes improvements.</p>"; fi
  if [ -n "$prev" ]; then
    echo "<h3>Earlier in $(version_family "$(get_var VER mac)")</h3>"
    lines_to_html "$prev"
  fi
}

if [ "$TARGET" = apple ]; then
  RELEASE_MSG="release: v$(get_var VER mac) (r${N}, Mac and iOS)"
else
  RELEASE_MSG="release(${TARGET}): v$(get_var VER "$TARGET") (r${N})"
fi
TAGS=""
for p in $PLATFORMS; do TAGS+="$(get_var TAG "$p") "; done
TAGS="${TAGS% }"

# The apps moving on from a version, whose summary the release commit writes: "<app> <old version>" lines.
FINISHED=""
for p in $PLATFORMS; do
  cur=$(get_var CUR "$p")
  if [ "$(get_var VER "$p")" != "$cur" ] && [ -d "$ROOT/release-notes/$p/v${cur}" ] &&
    [ ! -e "$ROOT/release-notes/$p/v${cur}.md" ]; then
    FINISHED+="$p $cur"$'\n'
  fi
done

# A version's summary, for the people making the app (INTERNAL included).
render_consolidated() { # render_consolidated <platform> <version>
  echo "# $(label "$1") $2"
  echo
  render_consolidated_lines "$ROOT/release-notes/$1/v$2"
}

# ---- do it (or, in a dry run, say what would happen) -------------------------------------------------------
UPLOAD_RESULT=""
IOS_RESULT=""
if [ -n "$DRYRUN" ]; then
  for p in $PLATFORMS; do
    echo
    case "$p" in
      ios) echo "[dry run] iOS's What to Test, into ${IOS_NOTES_DIR#"$ROOT"/}/WhatToTest.{en-GB,en-US}.txt:"
           echo "────────────────────────────────────────"; ios_notes; echo
           echo "────────────────────────────────────────" ;;
      mac) echo "[dry run] the Mac update's notes, in Sparkle's window (HTML in the appcast):"
           echo "────────────────────────────────────────"; mac_notes_html
           echo "────────────────────────────────────────" ;;
    esac
    echo "[dry run] $(label "$p"): $(get_var CUR "$p") → $(get_var VER "$p")"
    echo "[dry run] move the pending notes into release-notes/$p/v$(get_var VER "$p")/:"
    pending=("$ROOT/release-notes/$p/pending"/*.md)
    if [ "${#pending[@]}" -eq 0 ]; then echo "  (none)"; else for f in "${pending[@]}"; do echo "  $(basename "$f")"; done; fi
  done
  while read -r p old; do
    [ -n "$p" ] || continue
    echo "[dry run] write release-notes/$p/v${old}.md, ${old}'s summary"
  done <<<"$FINISHED"
  echo "[dry run] commit '${RELEASE_MSG}' and tag it ${TAGS// / and }"
  if has mac; then echo "[dry run] build Hammock $(get_var VER mac) (${N}) from it, notarize it and make its appcast (scripts/mac-update build)"; fi
  if has ios; then echo "[dry run] archive the iPhone's $(get_var VER ios) (${N}) from it, signed for App Store Connect (scripts/ios-testflight build)"; fi
  echo "[dry run] push main and ${TAGS// / and } together"
  if has mac; then echo "[dry run] upload the update (scripts/mac-update upload ${N})"; fi
  if has ios; then echo "[dry run] upload the iPhone's build to TestFlight (scripts/ios-testflight upload ${N})"; fi
else
  if [ "$NONINTERACTIVE" != 1 ]; then
    building=""
    if has mac; then building+=", build the Mac app"; fi
    if has ios; then building+=", build the iPhone app"; fi
    gum confirm "Freeze the notes, commit, tag ${TAGS// / and }${building} and push?" ||
      { echo "Stopped."; exit 1; }
  fi
  START=$(git -C "$ROOT" rev-parse HEAD)
  # While the release commit sits on main unpushed, the pre-push hook (.githooks/pre-push) keeps everyone
  # else from pushing main, and from pushing that commit; this script's own push says it's the release.
  RELEASE_LOCK="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir)/hammock-release.lock"
  echo $$ >"$RELEASE_LOCK"
  export HMK_RELEASING=1
  if has mac; then
    MAC_NOTES="$(mktemp -d)/notes.html"
    mac_notes_html >"$MAC_NOTES"
  fi
  for p in $PLATFORMS; do
    ver=$(get_var VER "$p")
    if [ "$ver" != "$(get_var CUR "$p")" ]; then
      write_version "$ROOT" "$p" "$ver"
      git -C "$ROOT" add -- "$(version_file "$ROOT")"
    fi
    mkdir -p "$ROOT/release-notes/$p/v${ver}"
    for f in "$ROOT/release-notes/$p/pending"/*.md; do git -C "$ROOT" mv "$f" "$ROOT/release-notes/$p/v${ver}/"; done
    git -C "$ROOT" add -A -- "$ROOT/release-notes/$p"
    if [ "$p" = ios ]; then
      mkdir -p "$IOS_NOTES_DIR"
      for locale in $IOS_NOTES_LOCALES; do printf '%s\n' "$(ios_notes)" >"$IOS_NOTES_DIR/WhatToTest.$locale.txt"; done
      git -C "$ROOT" add -A -- "$IOS_NOTES_DIR"
    fi
  done
  while read -r p old; do
    [ -n "$p" ] || continue
    render_consolidated "$p" "$old" >"$ROOT/release-notes/$p/v${old}.md"
    git -C "$ROOT" add -- "$ROOT/release-notes/$p/v${old}.md"
  done <<<"$FINISHED"
  # --allow-empty: two maintenance releases in a row change nothing, but each still needs a commit to tag.
  git -C "$ROOT" commit --allow-empty -q -m "$RELEASE_MSG"
  [ "$("$ROOT/scripts/commit-number" "$ROOT")" = "$N" ] ||
    { echo "The release commit isn't number $N on main; stopping." >&2; git -C "$ROOT" reset -q --hard "$START"; rm -f "$RELEASE_LOCK"; exit 1; }
  # Until the push lands, any failure takes the release back: the local tags (one left behind would block
  # the next run) and the release commit, leaving the checkout where it started.
  RELEASE_SHA=$(git -C "$ROOT" rev-parse HEAD)
  # Only ever undoes its own commit: if something was committed on top of it in this checkout (another session
  # sharing it), resetting would throw that away, so it's left for a person to sort out.
  undo() {
    local t
    for t in $TAGS; do git -C "$ROOT" tag -d "$t" >/dev/null 2>&1 || true; done
    if [ "$(git -C "$ROOT" rev-parse HEAD)" = "$RELEASE_SHA" ]; then
      git -C "$ROOT" reset -q --hard "$START"
    else
      echo "HEAD moved past the release commit (${RELEASE_SHA:0:7}) while it built: something else committed in this" >&2
      echo "checkout. Left as it is; drop the release commit by hand. Cut releases from a worktree of their own." >&2
    fi
    if has mac; then "$MAC_UPDATE" discard "$N" || true; fi
    if has ios; then "$IOS_TESTFLIGHT" discard "$N" || true; fi
    echo "Nothing was published; the release commit and tags (${TAGS}) are gone." >&2
    rm -f "$RELEASE_LOCK"
  }
  trap undo EXIT
  for t in $TAGS; do git -C "$ROOT" tag "$t"; done
  if has mac; then "$MAC_UPDATE" build "$N" "$MAC_NOTES"; fi
  if has ios; then "$IOS_TESTFLIGHT" build "$N"; fi
  if [ "$(git -C "$ROOT" rev-parse HEAD)" != "$RELEASE_SHA" ]; then
    echo "Something was committed on top of the release commit while it built; stopping before the push." >&2
    exit 1
  fi
  # One atomic push, so main and the tags arrive together or not at all: the release commit itself, never
  # whatever HEAD has become.
  refs=()
  for t in $TAGS; do refs+=("refs/tags/$t"); done
  if ! git -C "$ROOT" push --atomic origin "$RELEASE_SHA:refs/heads/main" "${refs[@]}"; then
    echo "The push was rejected (did main move?)." >&2
    exit 1
  fi
  trap - EXIT
  rm -f "$RELEASE_LOCK"

  # Pushed, so from here nothing fails the release: an upload that doesn't go through says how to retry.
  if has mac; then
    if "$MAC_UPDATE" upload "$N"; then
      UPLOAD_RESULT="uploaded; installed copies will be offered it"
    else
      UPLOAD_RESULT="NOT uploaded (see above); the release is cut. Retry: scripts/mac-update upload ${N}"
    fi
  fi
  if has ios; then
    if "$IOS_TESTFLIGHT" upload "$N"; then
      IOS_RESULT="uploaded to TestFlight"
    else
      IOS_RESULT="NOT uploaded (see above); the release is cut. Retry: scripts/ios-testflight upload ${N}"
    fi
  fi
fi

# ---- summary -----------------------------------------------------------------------------------------------
echo
echo "── Release ──────────────────────────────"
for p in $PLATFORMS; do
  printf '%-15s%s\n' "$(label "$p"):" "$(get_var VER "$p") (was $(get_var CUR "$p"))"
done
echo "Tags:          ${TAGS// / and }"
for p in $PLATFORMS; do echo "Notes:         release-notes/$p/v$(get_var VER "$p")/"; done
for p in $PLATFORMS; do
  case "$p" in
    mac)
      echo "Mac build:     ${N}"
      if [ -n "$UPLOAD_RESULT" ]; then echo "Mac update:    ${UPLOAD_RESULT}"; fi
      ;;
    ios)
      echo "iOS build:     ${N}"
      if [ -n "$IOS_RESULT" ]; then echo "TestFlight:    ${IOS_RESULT}"; fi
      ;;
  esac
done
# `if`, not `[ ] &&`: as the last command, a false test would make every real release exit 1.
if [ -n "$DRYRUN" ]; then echo "(dry run: nothing was changed, committed or pushed)"; fi
